# Copiar a `.env` y completar. `.env` está en .gitignore y no debe versionarse.

# Contraseña de PostgreSQL. Generala, no la inventes:
#   openssl rand -hex 24
#
# 🔴 -hex y NO -base64. Base64 produce `/` y `+`, y esto se interpola crudo en
#    DATABASE_URL: una barra termina la sección de autoridad de la URI y el
#    arranque falla con «failed to resolve host 'dude'», un mensaje que apunta
#    a DNS y no tiene nada que ver. Con 32 caracteres base64 la probabilidad de
#    que salga al menos un carácter problemático es del 64 %.
POSTGRES_PASSWORD=

POSTGRES_DB=dude
POSTGRES_USER=dude

# Dónde está la base de The Dude EN EL ANFITRIÓN. Se monta en sólo lectura.
# En la VM de producción: /srv/thedude/data
DUDE_DATA=/srv/thedude/data

# Cada cuántos segundos sincroniza el ETL.
# The Dude confirma a disco cada 10 s (dbCommitInterval), así que 30 alcanza.
SYNC_INTERVAL=30

# Puerto del panel EN LOCALHOST del anfitrión. No se publica hacia afuera.
WEB_PORT=4321
