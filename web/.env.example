# Conexión a PostgreSQL del panel (la que llena el ETL).
DATABASE_URL=postgres://dude:clave@localhost:5432/dudepanel

# Directorio `files/` de The Dude, montado junto a dude.db. Ahí están los SVG
# de los iconos. Si no existe, el visor usa sus iconos de repuesto.
DUDE_FILES_DIR=/datos/dude/files

# Tamaño del pool de conexiones. Subirlo sólo si el panel tiene muchos usuarios
# a la vez; el ETL también necesita conexiones.
# PGPOOL_MAX=10

# Cuándo avisar que los datos no están frescos, en segundos.
# El ETL corre cada 30 s, así que 180/600 dan margen de sobra.
# SYNC_UMBRAL_DEMORADA=180
# SYNC_UMBRAL_VIEJA=600

# PORT=4321
