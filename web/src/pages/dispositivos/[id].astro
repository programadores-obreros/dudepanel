---
import Base from '@/layouts/Base.astro';
import Pildora from '@/components/Pildora.astro';
import ListaCaidas from '@/components/ListaCaidas.astro';
import Antiguedad from '@/components/Antiguedad.astro';
import Accesos from '@/components/Accesos.astro';
import Grafico from '@/components/Grafico.astro';
import LineaDeTiempo from '@/components/LineaDeTiempo.astro';
import FotoEquipo from '@/components/FotoEquipo.astro';
import {
  cadenaDePadresInferida,
  arrastreDe,
  coberturaTopologia,
  caidasDe,
  coberturaHistoria,
  datosDeAcceso,
  hijosInferidos,
  historiaDe,
  lineaDeTiempoDe,
  mapasDeDispositivo,
  obtenerDispositivo,
  serviciosDe,
  spanMedicionesDe,
} from '@/lib/consultas';
import { esOpcionVentana, resolverVentana } from '@/lib/linea-tiempo';
import { accesos as calcularAccesos, type Acceso } from '@/lib/accesos';
import { fabricante, macsReales } from '@/lib/oui';
import { duracion, numero } from '@/lib/formato';
import { reportarError } from '@/lib/errores';

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/dispositivos', 302);

let d = null;
let servicios: Awaited<ReturnType<typeof serviciosDe>> = [];
let padres: Awaited<ReturnType<typeof cadenaDePadresInferida>> = [];
let hijos: Awaited<ReturnType<typeof hijosInferidos>> = [];
let arrastre: Awaited<ReturnType<typeof arrastreDe>> | null = null;
let cobertura: Awaited<ReturnType<typeof coberturaTopologia>> | null = null;
let mapas: Awaited<ReturnType<typeof mapasDeDispositivo>> = [];
let caidas: Awaited<ReturnType<typeof caidasDe>> = [];
/**
 * 🔴 «Nadie» y «no cargado» son afirmaciones distintas, y la ficha las decía
 *    igual: con `device_parents` vacía escribía «No cuelga de ningún equipo. Es
 *    raíz de la topología», que es una afirmación FALSA sobre la red. En esta
 *    instalación The Dude nunca guardó `parentIDs` en ninguno de sus 885
 *    equipos, así que lo cierto es que el dato no existe.
 */
let accesos: Acceso[] = [];
let series: Awaited<ReturnType<typeof historiaDe>> = [];
let covHistoria: Awaited<ReturnType<typeof coberturaHistoria>> | null = null;
let linea: Awaited<ReturnType<typeof lineaDeTiempoDe>> | null = null;
let error: string | null = null;

/**
 * La ventana de la línea de tiempo va por `?lt=` y NO por el `?h=` de la
 * historia de arriba. Son dos preguntas distintas: `?h=` elige un rango fijo
 * («últimas 24 h») y `?lt=medido` se ancla al tramo que tiene mediciones, que
 * hoy son unas dos horas por equipo. Compartir el parámetro obligaría a que un
 * gráfico mintiera para que el otro tuviera sentido.
 */
const opcionLinea = (() => {
  const v = Astro.url.searchParams.get('lt');
  return esOpcionVentana(v) ? v : 'medido';
})();
const ahoraS = Math.floor(Date.now() / 1000);
let ventanaLinea = resolverVentana(opcionLinea, ahoraS, null);

/**
 * Cuántas horas de historia se muestran. Va por la URL para que un enlace a
 * «este equipo, últimos 7 días» se pueda pegar en un chat y llegue igual.
 */
const HORAS = [
  { h: 6, texto: '6 h' },
  { h: 24, texto: '24 h' },
  { h: 24 * 7, texto: '7 d' },
  { h: 24 * 30, texto: '30 d' },
];
const horasPedidas = Number(Astro.url.searchParams.get('h'));
const horas = HORAS.some((o) => o.h === horasPedidas) ? horasPedidas : 24;

try {
  d = await obtenerDispositivo(id);
  if (d) {
    let acc: Awaited<ReturnType<typeof datosDeAcceso>> = null;
    let span: Awaited<ReturnType<typeof spanMedicionesDe>> = null;
    [servicios, padres, hijos, mapas, caidas, arrastre, cobertura, acc, series, span] =
      await Promise.all([
        serviciosDe(id),
        cadenaDePadresInferida(id),
        hijosInferidos(id),
        mapasDeDispositivo(id),
        caidasDe(id, 20),
        arrastreDe(id),
        coberturaTopologia(),
        datosDeAcceso(id),
        historiaDe(id, horas),
        // Va acá y no adentro de `lineaDeTiempoDe` porque la ventana `medido`
        // hay que resolverla ANTES de pedir la serie: es lo que decide qué
        // tramo se pide. Son dos índices, cuesta nada.
        spanMedicionesDe(id),
      ]);
    if (acc) accesos = calcularAccesos(acc);
    // Sólo cuando hace falta explicar un vacío. En el camino normal —el equipo
    // TIENE mediciones— esta consulta no se hace, y son 885 fichas por turno.
    if (series.length === 0) covHistoria = await coberturaHistoria();
    ventanaLinea = resolverVentana(opcionLinea, ahoraS, span);
    linea = await lineaDeTiempoDe(id, ventanaLinea.desde, ventanaLinea.hasta);
  }
} catch (e) {
  error = reportarError('dispositivos/[id]', e);
}

if (!d && !error) return new Response('Equipo no encontrado', { status: 404 });

// Direcciones MAC de verdad, y la marca que se deduce de ellas. Ver `lib/oui`.
const macs = macsReales(d?.macs);
const marca = fabricante(macs);

// El padre caído es el dato que resuelve la guardia: si el troncal está abajo,
// que este equipo esté abajo no es una falla propia, es una consecuencia.
const padreCaido = arrastre?.culpable ?? null;

const SNMP = ['v1', 'v2c', 'v3'];
---

<Base titulo={d?.nombre ?? 'Equipo'}>
  {
    error ? (
      <div class="border-caido bg-caido-bg text-caido-txt rounded-xl border-2 p-4">
        <p class="font-bold">No se pudo leer el equipo</p>
        <p class="mt-1 font-mono text-xs break-all">{error}</p>
      </div>
    ) : (
      <div class="flex flex-col gap-4">
        {/* ── Encabezado ─────────────────────────────────────────────────── */}
        <div>
          <nav aria-label="Migas" class="text-tenue text-2xs">
            <a href="/dispositivos" class="enlace">Equipos</a>
            <span aria-hidden="true"> / </span>
          </nav>
          <div class="mt-0.5 flex flex-wrap items-center gap-2.5">
            <h1 class="text-xl font-bold tracking-tight sm:text-2xl">{d!.nombre}</h1>
            <Pildora estado={d!.status} />
            {/* Al lado del estado, no enterrado en la ficha: es la mitad de la
                información. «Caído» y «caído hace cuatro años» piden cosas
                distintas y hasta acá se leían igual. */}
            <Antiguedad estado={d!.status} desde={d!.estado_desde} variante="larga" />
            {d!.router_os && (
              <span class="border-borde text-tenue text-2xs rounded border px-1.5 py-0.5 font-semibold">
                RouterOS
              </span>
            )}
            {d!.dude_server && (
              <span class="border-acento/50 bg-acento-bg text-acento-txt text-2xs rounded border px-1.5 py-0.5 font-semibold">
                Servidor de The Dude
              </span>
            )}
          </div>
          {d!.direcciones.length > 0 && (
            <p class="text-tenue mt-1 font-mono text-sm">{d!.direcciones.join(' · ')}</p>
          )}
        </div>

        {padreCaido && (
          <div class="border-parcial bg-parcial-bg text-parcial-txt rounded-xl border-2 p-3">
            <p class="text-sm font-bold">Puede ser arrastre, no falla propia</p>
            <p class="mt-0.5 text-xs">
              De este equipo depende{' '}
              <a href={`/dispositivos/${padreCaido.id}`} class="font-semibold underline">
                {padreCaido.nombre ?? `#${padreCaido.id}`}
              </a>
              , que también está caído. Arreglá ese primero.
            </p>
          </div>
        )}

        {/* ── Acceso al equipo ─────────────────────────────────────────────
            Arriba de todo, antes de los servicios. Cuando alguien abre la
            ficha de un equipo caído a las tres de la mañana, lo que necesita
            es entrar — no leer. Lo que se busca primero va primero. */}
        <section class="tarjeta mb-4 p-3">
          <Accesos accesos={accesos} nombre={d!.nombre} />
        </section>

        <div class="grid gap-4 lg:grid-cols-[2fr_1fr]">
          <div class="flex flex-col gap-4">
            {/* ── Línea de tiempo ──────────────────────────────────────────
                Antes de «Historia medida» a propósito. La pregunta que trae a
                alguien a esta ficha es «¿la latencia venía subiendo antes de
                que se cayera?», y eso sólo se contesta con las caídas y la
                latencia sobre el MISMO eje. Los gráficos sueltos de abajo
                sirven para mirar una serie; este sirve para entender. */}
            {linea && <LineaDeTiempo datos={linea} ventana={ventanaLinea} ruta={`/dispositivos/${d!.id}`} ahora={ahoraS} />}

            {/* ── Historia medida ─────────────────────────────────────────── */}
            <section class="tarjeta overflow-hidden" aria-labelledby="t-graf">
              <header
                class="border-borde flex flex-wrap items-center justify-between gap-2 border-b px-3 py-2"
              >
                <h2 id="t-graf" class="text-sm font-semibold">Historia medida</h2>
                <nav class="flex gap-1" aria-label="Rango de tiempo del gráfico">
                  {
                    HORAS.map((o) => (
                      <a
                        href={`?h=${o.h}`}
                        class:list={[
                          'text-2xs rounded px-2 py-1 tabular-nums transition-colors duration-150',
                          o.h === horas
                            ? 'bg-acento text-fondo font-semibold'
                            : 'text-tenue hover:bg-panel-2 hover:text-texto',
                        ]}
                        aria-current={o.h === horas ? 'page' : undefined}
                      >
                        {o.texto}
                      </a>
                    ))
                  }
                </nav>
              </header>

              {
                series.length === 0 ? (
                  /* 🔴 Un gráfico vacío se lee como «no hay tráfico», que es
                     una afirmación sobre la red. Acá se dice la verdad: el
                     dato no está. Y se dice POR QUÉ, que es lo que evita que
                     alguien lo reporte como una falla del panel. */
                  <p class="text-tenue p-3 text-sm leading-relaxed">
                    No hay mediciones de este equipo en las últimas{' '}
                    {horas < 48 ? `${horas} horas` : `${Math.round(horas / 24)} días`}.
                    <br />
                    <span class="text-xs">
                      The Dude guarda historia sólo de los servicios con gráfico habilitado.
                      {covHistoria && covHistoria.total > 0 && (
                        <>
                          {' '}En esta instalación son{' '}
                          <strong class="text-texto">
                            {covHistoria.con} de {covHistoria.total}
                          </strong>{' '}
                          equipos, casi todos de latencia de ping.
                        </>
                      )}
                    </span>
                  </p>
                ) : (
                  <div class="flex flex-col gap-3 p-3">
                    {series.map((s) => (
                      <Grafico
                        titulo={s.nombre}
                        unidad={s.unidad}
                        puntos={s.puntos}
                        bucket={s.bucket}
                      />
                    ))}
                  </div>
                )
              }
            </section>

            {/* ── Servicios ───────────────────────────────────────────────── */}
            <section class="tarjeta overflow-hidden" aria-labelledby="t-srv">
              <header class="border-borde flex items-center justify-between gap-2 border-b px-3 py-2">
                <h2 id="t-srv" class="text-sm font-semibold">Servicios monitoreados</h2>
                <span class="text-tenue text-2xs cifra">
                  {d!.services_up} de {d!.services_total} arriba
                </span>
              </header>

              {servicios.length === 0 ? (
                <p class="text-tenue px-3 py-6 text-center text-xs">
                  Sin servicios monitoreados. El equipo está cargado pero nadie lo sondea.
                </p>
              ) : (
                <div class="overflow-x-auto">
                  <table class="w-full border-collapse text-left">
                    <thead>
                      <tr class="border-borde bg-panel-2 text-2xs border-b uppercase">
                        <th scope="col" class="w-28 px-2.5 py-1.5 font-semibold">Estado</th>
                        <th scope="col" class="px-2.5 py-1.5 font-semibold">Sonda</th>
                        <th scope="col" class="px-2.5 py-1.5 text-right font-semibold">
                          Así desde hace
                        </th>
                        {/* 🔴 `timeLastDown` es una DURACIÓN, no una fecha: es
                            cuánto duró la última caída. Ver `Servicio`. */}
                        <th scope="col" class="hidden px-2.5 py-1.5 text-right font-semibold sm:table-cell">
                          Última caída duró
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-borde divide-y">
                      {servicios.map((s) => (
                        <tr>
                          <td class="px-2.5 py-1.5">
                            <Pildora estado={s.status} />
                          </td>
                          <td class="px-2.5 py-1.5 text-sm">
                            {s.sonda ?? <span class="text-tenue">sonda #{s.id}</span>}
                            {s.probe_port ? (
                              <span class="text-tenue text-2xs font-mono"> :{s.probe_port}</span>
                            ) : null}
                            <span class="mt-0.5 flex flex-wrap gap-1.5">
                              {s.enabled === false && (
                                <span class="text-tenue border-borde text-2xs rounded border px-1">
                                  deshabilitada
                                </span>
                              )}
                              {s.acked && (
                                <span class="text-acento-txt border-acento/40 text-2xs rounded border px-1">
                                  reconocida
                                </span>
                              )}
                              {(s.probes_down ?? 0) > 0 && (
                                <span class="text-caido-txt text-2xs">
                                  {s.probes_down} fallos seguidos
                                </span>
                              )}
                            </span>
                          </td>
                          <td class="px-2.5 py-1.5 text-right">
                            <Antiguedad estado={s.status} desde={s.cambio_en} variante="larga" />
                          </td>
                          <td class="text-tenue hidden px-2.5 py-1.5 text-right text-xs tabular-nums sm:table-cell">
                            {s.duro_caido_s ? duracion(s.duro_caido_s) : '—'}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>

            {/* ── Historial ───────────────────────────────────────────────── */}
            <section class="tarjeta overflow-hidden" aria-labelledby="t-hist">
              <header class="border-borde flex items-center justify-between gap-2 border-b px-3 py-2">
                <h2 id="t-hist" class="text-sm font-semibold">Historial de caídas</h2>
                {/* «últimas 0» era ruido: si no hay ninguna, el propio cuerpo
                    de la lista ya lo dice con una frase. */}
                {caidas.length > 0 && (
                  <span class="text-tenue text-2xs">últimas {numero(caidas.length)}</span>
                )}
              </header>
              <ListaCaidas
                caidas={caidas}
                conEquipo={false}
                vacio="Este equipo nunca registró una caída."
              />
            </section>
          </div>

          {/* ── Barra lateral ─────────────────────────────────────────────── */}
          <aside class="flex flex-col gap-4">
            {/* Arriba de todo: es lo primero que se mira, y para el que está
                por salir a un sitio es lo que le dice qué se va a encontrar. */}
            <FotoEquipo id={d!.id} nombre={d!.nombre} tipo={d!.tipo} />

            <section class="tarjeta p-3" aria-labelledby="t-ficha">
              <h2 id="t-ficha" class="text-tenue text-2xs mb-2 font-semibold tracking-wide uppercase">
                Ficha
              </h2>
              <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-xs">
                <dt class="text-tenue">Tipo</dt>
                <dd>{d!.tipo ?? '—'}</dd>

                <dt class="text-tenue">Direcciones</dt>
                <dd class="font-mono break-all">{d!.direcciones.join(', ') || '—'}</dd>

                {d!.dns_names && (
                  <>
                    <dt class="text-tenue">DNS</dt>
                    <dd class="font-mono break-all">{d!.dns_names}</dd>
                  </>
                )}

                {/* 🔴 `macsReales` y no `d.macs` a secas: The Dude guarda seis
                    bytes que dicen «\0dude-» en el campo de la MAC de 112
                    equipos, y el panel los mostraba como `00:64:75:64:65:2d`.
                    Una dirección inventada que se ve plausible es peor que un
                    campo vacío: alguien la copia y la busca en un switch. */}
                {macs.length > 0 && (
                  <>
                    <dt class="text-tenue">MAC</dt>
                    <dd class="font-mono break-all">{macs.join(', ')}</dd>
                  </>
                )}

                {/* El fabricante sale del OUI de la MAC. Es lo único que se
                    puede saber de la marca sin preguntarle nada al equipo: el
                    90 % de los equipos tiene MAC, contra el 12,5 % que
                    contesta SNMP. */}
                {marca && (
                  <>
                    <dt class="text-tenue">Fabricante</dt>
                    <dd>
                      {marca.nombre}
                      <span
                        class="text-tenue text-2xs ml-1"
                        title={
                          marca.fuente === 'iconos'
                            ? 'Deducido de los iconos que se le asignaron a los equipos de este mismo prefijo en esta instalación. No está confirmado contra el registro del IEEE.'
                            : marca.fuente === 'ieee'
                              ? 'Por el prefijo de la MAC, según el registro del IEEE.'
                              : 'Por el prefijo de la MAC (registro del IEEE), y coincide con los iconos asignados a mano en esta instalación.'
                        }
                      >
                        {marca.fuente === 'iconos' ? '· deducido' : '· por la MAC'}
                      </span>
                    </dd>
                  </>
                )}

                <dt class="text-tenue">SNMP</dt>
                <dd>
                  {d!.perfil_snmp ? (
                    <>
                      {d!.perfil_snmp}
                      {d!.snmp_version != null && (
                        <span class="text-tenue"> ({SNMP[d!.snmp_version] ?? '?'})</span>
                      )}
                    </>
                  ) : (
                    <span class="text-tenue">hereda del servidor</span>
                  )}
                </dd>

                <dt class="text-tenue">Sondeo</dt>
                <dd>
                  {/* «cada lo del servidor» — así se leía cuando el intervalo
                      viene nulo, que son la mayoría. La rama sin intervalo no
                      puede empezar con «cada»: es otra frase, no un hueco. */}
                  {d!.probe_enabled === false ? (
                    <span class="text-parcial-txt font-semibold">deshabilitado</span>
                  ) : d!.probe_interval ? (
                    <>
                      cada {d!.probe_interval} s
                      {d!.probe_down_count ? `, ${d!.probe_down_count} fallos para caer` : ''}
                    </>
                  ) : (
                    <>
                      <span class="text-tenue">hereda el intervalo del servidor</span>
                      {d!.probe_down_count ? `, ${d!.probe_down_count} fallos para caer` : ''}
                    </>
                  )}
                </dd>

                <dt class="text-tenue">Id</dt>
                <dd class="font-mono">{d!.id}</dd>
              </dl>

              {/* Nota permanente: el panel NO tiene las credenciales y eso es
                  deliberado, no un olvido. Que quede escrito evita que alguien
                  "arregle" el ETL agregándolas. */}
              <p class="border-borde text-tenue text-2xs mt-3 border-t pt-2">
                El panel no guarda usuarios ni contraseñas de los equipos. El ETL no los lee.
              </p>
            </section>

            {/* ── Dependencias ────────────────────────────────────────────── */}
            <section class="tarjeta overflow-hidden" aria-labelledby="t-dep">
              <h2 id="t-dep" class="border-borde border-b px-3 py-2 text-sm font-semibold">
                Depende de
              </h2>
              {padres.length === 0 ? (
                /* 🔴 «No depende de nadie» y «no sé de quién depende» son
                   afirmaciones distintas, y confundirlas es mentir sobre la
                   red. `motivo_sin_padre` dice CUÁL de las dos es.

                   Y ninguna sale ya de `device_parents`: esa tabla está VACÍA
                   —The Dude nunca guardó `parentIDs` en ninguno de los 885
                   equipos— y por eso esta sección no servía. Ahora la
                   topología se INFIERE del grafo de 1.092 enlaces dibujados
                   en los mapas. Ver `lib/topologia.ts`. */
                <p class="text-tenue px-3 py-4 text-xs leading-relaxed">
                  {arrastre?.motivo_sin_padre === 'fuera-del-grafo' ? (
                    <>
                      <strong class="text-tinta block font-semibold">
                        No se sabe de qué depende.
                      </strong>
                      Este equipo no aparece en ningún enlace dibujado, así que no hay de dónde
                      deducirlo. No es que no dependa de nada.
                    </>
                  ) : arrastre?.motivo_sin_padre === 'raiz-del-grafo' ? (
                    <>
                      <strong class="text-tinta block font-semibold">Parece ser cabecera.</strong>
                      Es el nodo con más enlaces de su parte de la red, así que la inferencia lo
                      toma como origen. Deducido del dibujo, no declarado por nadie.
                    </>
                  ) : arrastre?.motivo_sin_padre === 'sin-padre-resoluble' ? (
                    <>
                      <strong class="text-tinta block font-semibold">
                        Cuelga de un sitio, pero arriba no hay equipo.
                      </strong>
                      El enlace sube a la caja de otro mapa y ahí no hay ningún equipo dibujado del
                      que colgar. El lugar se sabe; el equipo, no.
                    </>
                  ) : (
                    'No se pudo deducir de qué depende.'
                  )}
                  {cobertura && (
                    <span class="mt-1.5 block">
                      La topología está deducida para{' '}
                      <strong class="text-tinta">
                        {numero(cobertura.con_padre)} de {numero(cobertura.total)}
                      </strong>{' '}
                      equipos.
                    </span>
                  )}
                </p>
              ) : (
                <ul class="divide-borde divide-y">
                  {padres.map((v) => (
                    <li>
                      <a
                        href={`/dispositivos/${v.id}`}
                        class="hover:bg-panel-2 flex items-center gap-2 px-3 py-1.5 no-underline"
                        style={`padding-left:${0.75 + (v.nivel - 1) * 0.75}rem`}
                      >
                        {v.nivel > 1 && (
                          <span class="text-tenue text-2xs" aria-hidden="true">
                            ↳
                          </span>
                        )}
                        <Pildora estado={v.status} compacta />
                        <span class="truncate text-xs">{v.nombre ?? `#${v.id}`}</span>
                        {/* 🔴 La confianza NO es decorativa. Esto es una
                            INFERENCIA sobre un grafo NO DIRIGIDO: «A está
                            unido con B» no dice cuál cuelga de cuál. Un
                            eslabón «dudoso» puede estar al revés, y quien mire
                            esto a las tres de la mañana tiene que poder
                            distinguirlo de uno seguro antes de mandar a
                            alguien a una torre. */}
                        {v.confianza !== 'alta' && (
                          <span
                            class="border-borde text-tenue text-2xs ml-auto shrink-0 rounded border px-1 py-px"
                            title={
                              v.confianza === 'media'
                                ? 'Camino único en el grafo de enlaces, pero el padre no es claramente más central. Probable, no seguro.'
                                : 'Hay más de un camino posible, o el enlace cruza de sitio. Puede estar invertido.'
                            }
                          >
                            {v.confianza === 'media' ? 'probable' : 'dudoso'}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            {hijos.length > 0 && (
              <section class="tarjeta overflow-hidden" aria-labelledby="t-hijos">
                <h2 id="t-hijos" class="border-borde border-b px-3 py-2 text-sm font-semibold">
                  Cuelgan de este · {hijos.length}
                </h2>
                <ul class="divide-borde max-h-72 divide-y overflow-y-auto">
                  {hijos.map((v) => (
                    <li>
                      <a
                        href={`/dispositivos/${v.id}`}
                        class="hover:bg-panel-2 flex items-center gap-2 px-3 py-1.5 no-underline"
                      >
                        <Pildora estado={v.status} compacta />
                        <span class="truncate text-xs">{v.nombre ?? `#${v.id}`}</span>
                        {/* 🔴 La confianza NO es decorativa. Esto es una
                            INFERENCIA sobre un grafo NO DIRIGIDO: «A está
                            unido con B» no dice cuál cuelga de cuál. Un
                            eslabón «dudoso» puede estar al revés, y quien mire
                            esto a las tres de la mañana tiene que poder
                            distinguirlo de uno seguro antes de mandar a
                            alguien a una torre. */}
                        {v.confianza !== 'alta' && (
                          <span
                            class="border-borde text-tenue text-2xs ml-auto shrink-0 rounded border px-1 py-px"
                            title={
                              v.confianza === 'media'
                                ? 'Camino único en el grafo de enlaces, pero el padre no es claramente más central. Probable, no seguro.'
                                : 'Hay más de un camino posible, o el enlace cruza de sitio. Puede estar invertido.'
                            }
                          >
                            {v.confianza === 'media' ? 'probable' : 'dudoso'}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <section class="tarjeta overflow-hidden" aria-labelledby="t-mapas-d">
              <h2 id="t-mapas-d" class="border-borde border-b px-3 py-2 text-sm font-semibold">
                Aparece en
              </h2>
              {mapas.length === 0 ? (
                <p class="text-tenue px-3 py-4 text-xs">En ningún mapa.</p>
              ) : (
                <ul class="divide-borde divide-y">
                  {mapas.map((m) => (
                    <li>
                      <a
                        href={`/mapas/${m.id}`}
                        class="hover:bg-panel-2 block truncate px-3 py-1.5 text-xs no-underline"
                      >
                        {m.nombre}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </aside>
        </div>
      </div>
    )
  }
</Base>
