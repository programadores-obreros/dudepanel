---
import Base from '@/layouts/Base.astro';
import VisorMapa from '@/components/VisorMapa.astro';
import { reportarError } from '@/lib/errores';
import {
  alcanceHistoria,
  enlacesFueraDelMapa,
  lienzoMapa,
  obtenerMapa,
  resumenSubmapas,
  traficoDeMapa,
  type EnlacesFuera,
  type ResumenSubmapa,
  type TraficoEnlace,
} from '@/lib/consultas';
import { quien } from '@/lib/roles';
import { clasificar } from '@/lib/vida';
import { resolverVentana } from '@/lib/ventanas';

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/mapas', 302);

/**
 * Qué capa se está mirando.
 *
 * 🔴 Va por la URL y el filtrado ocurre en el SERVIDOR, no con CSS.
 *
 *    La tentación era dibujar todo y esconder con una clase: el interruptor
 *    sería instantáneo. Pero el ENCUADRE del mapa se calcula sobre los nodos,
 *    y con los muertos adentro el mapa «limpio» quedaría alejado y lleno de
 *    agujeros donde antes había equipos. Mostrar la realidad incluye el
 *    encuadre — si no, se cambió una mentira por otra más prolija.
 *
 *    Y por la URL para que «este mapa, como está hoy de verdad» se pueda pegar
 *    en un chat y le llegue igual al otro.
 */
const CAPAS = [
  { valor: 'activos', texto: 'En servicio', ayuda: 'Sólo los equipos que dieron señales de vida.' },
  { valor: 'dudosos', texto: '+ dudosos', ayuda: 'Suma los callados hace tiempo, atenuados.' },
  { valor: 'todo', texto: 'Todo', ayuda: 'También los dados de baja. Como estaba antes.' },
] as const;
type Capa = (typeof CAPAS)[number]['valor'];
const capa: Capa =
  (CAPAS.find((c) => c.valor === Astro.url.searchParams.get('capa'))?.valor as Capa) ?? 'activos';

/**
 * La ventana de «cayó recién», que RESALTA en vez de filtrar.
 *
 * Misma lista que en `/caidas` —`lib/ventanas.ts`— para que lo que se ve en una
 * pantalla se pueda cruzar con lo que se ve en la otra. Un «6 h» que significa
 * cosas distintas en dos lugares del mismo panel es peor que no tenerlo.
 *
 * 🔴 Acá NO recorta `elementos`, a diferencia de `capa`. Ver `ventanaH` en
 *    `VisorMapa.astro`: en un mapa, esconder el contexto tira lo único que el
 *    mapa aporta sobre una lista, que es el lugar.
 */
const ventana = resolverVentana(Astro.url.searchParams.get('desde'));

let mapa = null;
let elementos: Awaited<ReturnType<typeof lienzoMapa>> = [];
// Recuentos y no sólo estado: los rótulos de submapa piden «total / parciales /
// caídos» y son 145 elementos en la base real.
let submapas = new Map<number, ResumenSubmapa>();
let fuera: EnlacesFuera | undefined;
// El tráfico de los enlaces. Medido sobre `VLANS`: 0,58 ms — se pide siempre.
let trafico = new Map<number, TraficoEnlace>();
let error: string | null = null;
let alcance = 0;
/** Cuántos se dejaron afuera por la capa elegida. Se dice siempre. */
let ocultos = 0;

try {
  mapa = await obtenerMapa(id);
  if (mapa) {
    [elementos, submapas, fuera, trafico, alcance] = await Promise.all([
      lienzoMapa(id),
      resumenSubmapas(id),
      enlacesFueraDelMapa(id),
      traficoDeMapa(id),
      alcanceHistoria(),
    ]);

    // 🔴 Los enlaces y los rótulos NO se filtran acá.
    //
    //    Un enlace no tiene `device_id`, así que no tiene vida propia: la
    //    hereda de sus dos puntas. Filtrarlo por su cuenta sería inventar un
    //    criterio; `construirLienzo` ya descarta los que se quedaron sin
    //    extremo, y el visor informa cuántos faltan. Esa cuenta ya existe.
    const visible = (e: (typeof elementos)[number]) => {
      if (capa === 'todo' || e.device_id == null) return true;
      const { vida } = clasificar(
        {
          dias_sin_senal: e.dias_sin_senal ?? null,
          arriba_ahora: e.arriba_ahora ?? false,
          estado_manual: e.estado_manual ?? null,
        },
        alcance,
      );
      return vida === 'activo' || (capa === 'dudosos' && vida === 'dudoso');
    };
    const antes = elementos.length;
    elementos = elementos.filter(visible);
    ocultos = antes - elementos.length;
  }
} catch (e) {
  error = reportarError('mapas/[id]', e);
}

if (!mapa && !error) {
  return new Response('Mapa no encontrado', { status: 404 });
}

// Quién es y qué puede. Se resuelve en el servidor: el cliente no decide sus
// propios permisos, sólo se le dice qué se le ofrece.
const yo = quien(Astro.request);
// Cuántos nodos ya tienen posición puesta a mano — justifica el botón de
// volver al original, y dice de un vistazo si el mapa está acomodado.
const movidos = elementos.filter((e) => e.movido).length;
---

<Base titulo={mapa?.nombre ?? 'Mapa'} ancho="completo">
  <div class="mx-auto flex min-h-0 w-full max-w-[1600px] flex-1 flex-col gap-3 px-3 py-4 sm:px-5">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div class="min-w-0">
        <nav aria-label="Migas" class="text-tenue text-2xs">
          <a href="/mapas" class="enlace">Mapas</a>
          <span aria-hidden="true"> / </span>
        </nav>
        <h1 class="truncate text-xl font-bold tracking-tight sm:text-2xl">{mapa?.nombre}</h1>
      </div>
      <a
        href="/mapas"
        class="border-borde bg-panel hover:border-borde-fuerte shrink-0 rounded-lg border px-3 py-1.5 text-xs font-semibold no-underline"
      >
        Volver a los mapas
      </a>
    </div>

    {
      error ? (
        <div class="border-caido bg-caido-bg text-caido-txt rounded-xl border-2 p-4">
          <p class="font-bold">No se pudo dibujar el mapa</p>
          <p class="mt-1 font-mono text-xs break-all">{error}</p>
        </div>
      ) : elementos.length === 0 ? (
        <div class="tarjeta text-tenue grid flex-1 place-items-center p-8 text-center text-sm">
          <p>
            Este mapa está vacío.
            <br />
            <span class="text-2xs">
              En The Dude hay mapas sin elementos: no es un error del panel.
            </span>
          </p>
        </div>
      ) : (
        <VisorMapa
          mapaId={id}
          nombre={mapa!.nombre}
          elementos={elementos}
          submapas={submapas}
          fuera={fuera}
          trafico={trafico}
          editable={yo.puedeEditar}
          movidos={movidos}
          alcanceDias={alcance}
          capa={capa}
          ventanaH={ventana.horas}
          ocultos={ocultos}
        />
      )
    }
  </div>
</Base>
