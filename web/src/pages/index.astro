---
import Base from '@/layouts/Base.astro';
import Kpi from '@/components/Kpi.astro';
import Pildora from '@/components/Pildora.astro';
import EstadoSync from '@/components/EstadoSync.astro';
import ListaCaidas from '@/components/ListaCaidas.astro';
import {
  caidasRecientes,
  listarDispositivos,
  listarMapas,
  resumenRed,
  ultimaSincronizacion,
} from '@/lib/consultas';
import Antiguedad from '@/components/Antiguedad.astro';
import { numero, porcentaje } from '@/lib/formato';
import { accionables, ANTIGUEDADES, DIAS_RECIENTE } from '@/lib/antiguedad';
import { reportarError } from '@/lib/errores';

/**
 * Lo primero que mira alguien a las 3 de la mañana.
 *
 * Orden deliberado: primero si los datos sirven, después **qué mirar**, después
 * qué está roto, y sólo al final cuánto hay en total.
 *
 * 🔴 «Qué mirar» es nuevo y es el corazón de esta versión del tablero.
 *
 *    Antes lo primero que se veía era «267 CAÍDOS» en rojo, enorme. Medido
 *    sobre la base real, 121 de esos 267 llevan más de un año caídos: no son
 *    caídas, son equipos dados de baja que nadie sacó del monitoreo. Un número
 *    que arranca en 267 y del que casi la mitad no significa nada **entrena al
 *    operador a no mirarlo**, y el día que se caiga un troncal va a estar
 *    mezclado ahí adentro.
 *
 *    Los 267 siguen estando, y con el mismo tamaño de letra que antes: el panel
 *    no puede contradecir a The Dude. Lo que se agrega arriba es la partición
 *    que permite leerlos. Ver `antiguedad.ts`.
 */

let error: string | null = null;
let resumen = null;
let caidas: Awaited<ReturnType<typeof caidasRecientes>> = [];
let mapas: Awaited<ReturnType<typeof listarMapas>> = [];
let peores: Awaited<ReturnType<typeof listarDispositivos>> | null = null;
let sync = null;

try {
  [sync, resumen, caidas, mapas, peores] = await Promise.all([
    ultimaSincronizacion(),
    resumenRed(),
    caidasRecientes(10),
    listarMapas(),
    // 🔴 Por antigüedad y no por nombre. La lista se llamaba «Equipos caídos
    //    ahora» y venía ordenada alfabéticamente: las diez primeras filas eran
    //    diez direcciones IP que empiezan con 10.227, todas caídas desde hace
    //    años. O sea que el bloque que dice «ahora» mostraba lo más viejo que
    //    hay. Ordenado por lo último que cambió, dice lo que promete.
    listarDispositivos({ estado: 3, orden: 'antiguedad', porPagina: 10 }),
  ]);
} catch (e) {
  error = reportarError('index', e);
}

const mapasRotos = mapas.filter((m) => m.caidos > 0 || m.parcial > 0).slice(0, 8);
const eq = resumen?.equipos;
const edad = resumen?.caidos_por_antiguedad;
const edadSD = resumen?.desconocidos_por_antiguedad;

/** Los que de verdad piden algo: todo lo caído que no es residuo. */
const paraMirar = edad ? accionables(edad) : 0;
const residuo = edad?.residuo ?? 0;

const TILES = [
  { a: ANTIGUEDADES[0]!, n: edad?.reciente ?? 0, clave: 'eq-caidos-reciente' },
  { a: ANTIGUEDADES[1]!, n: edad?.arrastre ?? 0, clave: 'eq-caidos-arrastre' },
  { a: ANTIGUEDADES[2]!, n: edad?.residuo ?? 0, clave: 'eq-caidos-residuo' },
] as const;
---

<Base
  titulo="Panel"
  encabezado="Estado de la red"
  descripcion={
    resumen
      ? `${numero(paraMirar)} equipos caídos que piden atención · ${numero(residuo)} son residuo de más de un año`
      : 'el ISP — monitoreo en vivo'
  }
>
  <div slot="acciones" class="flex gap-2">
    <a
      href="/dispositivos?estado=3"
      class="border-caido/50 bg-caido-bg text-caido-txt hover:border-caido rounded-lg border px-3 py-1.5 text-xs font-semibold no-underline"
    >
      Ver equipos caídos
    </a>
  </div>

  {
    error ? (
      <div class="border-caido bg-caido-bg text-caido-txt rounded-xl border-2 p-4">
        <p class="font-bold">No se pudo leer el estado de la red</p>
        <p class="mt-1 font-mono text-xs break-all">{error}</p>
      </div>
    ) : (
      <div class="flex flex-col gap-4">
        {/* 1 · ¿Los datos sirven? Antes que cualquier número. */}
        <EstadoSync sync={sync} variante="aviso" />

        {/* 2 · QUÉ MIRAR. La partición que The Dude no da. ─────────────────
            Sale sólo si hay algo caído: en una red sana esta sección no tiene
            nada que decir y desaparece en vez de ocupar la primera pantalla
            con tres ceros. */}
        {
          eq && eq.caidos > 0 && edad && (
            <section class="tarjeta overflow-hidden" aria-labelledby="t-triage">
              <header class="border-borde flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b px-3 py-2">
                <h2 id="t-triage" class="text-sm font-semibold">
                  Qué mirar ahora
                </h2>
                <p class="text-tenue text-2xs">
                  de los <span class="cifra">{numero(eq.caidos)}</span> equipos caídos, por hace
                  cuánto que lo están
                </p>
              </header>

              <div class="divide-borde grid grid-cols-3 divide-x">
                {TILES.map((t) => (
                  <a
                    href={`/dispositivos?estado=3&edad=${t.a.clave}`}
                    class="hover:bg-panel-2 flex flex-col gap-0.5 px-3 py-2.5 no-underline"
                    title={t.a.explica}
                  >
                    <span class="text-tenue text-2xs flex items-center gap-1.5 font-semibold tracking-wide uppercase">
                      <span class="rampa" data-antiguedad={t.a.clave} aria-hidden="true" />
                      {t.a.etiqueta}
                    </span>
                    <span
                      class:list={[
                        'cifra text-2xl leading-none font-bold tabular-nums sm:text-3xl',
                        t.a.clave === 'reciente' && 'text-caido-txt',
                        t.a.clave === 'residuo' && 'text-tenue',
                      ]}
                      data-vivo={t.clave}
                    >
                      {numero(t.n)}
                    </span>
                    <span class="text-tenue text-2xs">
                      {t.a.clave === 'reciente'
                        ? `cambiaron hace menos de ${DIAS_RECIENTE} días`
                        : t.a.clave === 'arrastre'
                          ? `entre ${DIAS_RECIENTE} días y un año`
                          : 'más de un año igual'}
                    </span>
                  </a>
                ))}
              </div>

              {/* 🔴 El párrafo que explica por qué esto está acá. No es relleno:
                  sin él, tres números por antigüedad son una curiosidad. Con
                  él, son el argumento para dar de baja 121 equipos. */}
              {residuo > 0 && (
                <p class="border-borde bg-panel-2/60 text-tenue flex flex-wrap items-baseline gap-x-2 gap-y-1 border-t px-3 py-2 text-xs">
                  <span>
                    <strong class="text-tinta font-semibold">
                      {numero(residuo)} de {numero(eq.caidos)}
                    </strong>{' '}
                    llevan más de un año caídos. Casi seguro son bajas que nadie sacó del
                    monitoreo — y mientras sigan ahí, el tablero enseña a ignorar el rojo.
                  </span>
                  <a
                    href="/dispositivos?estado=3&edad=residuo&orden=antiguedad&dir=desc"
                    class="text-acento-txt ml-auto font-semibold whitespace-nowrap no-underline hover:underline"
                  >
                    Revisarlos →
                  </a>
                </p>
              )}

              {/* Lo mismo con «sin datos», que es donde vive el más viejo de
                  todos: hay uno que no reporta desde 2012. */}
              {edadSD && edadSD.residuo > 0 && (
                <p class="border-borde/70 text-tenue border-t px-3 py-1.5 text-2xs">
                  Y otros <strong class="font-semibold">{numero(edadSD.residuo)}</strong> están en
                  «sin datos» hace más de un año.{' '}
                  <a
                    href="/dispositivos?estado=0&edad=residuo&orden=antiguedad&dir=desc"
                    class="text-acento-txt font-semibold no-underline hover:underline"
                  >
                    Verlos
                  </a>
                </p>
              )}
            </section>
          )
        }

        {/* 3 · Los cuatro estados, tal cual los cuenta The Dude. ────────────
            🔴 Estos NO se tocan ni se recalculan con la antigüedad. Si el panel
               dijera «146 caídos» porque descontó los residuos, estaría
               contradiciendo a la herramienta que sigue siendo la fuente de
               verdad, y dos números distintos para lo mismo en dos pantallas
               es peor que un número incómodo. */}
        <section aria-labelledby="t-equipos">
          <h2 id="t-equipos" class="text-tenue mb-2 text-2xs font-semibold tracking-wide uppercase">
            Equipos · {numero(eq?.total ?? 0)} en total
          </h2>
          <div class="grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-4">
            <Kpi
              titulo="Caídos"
              valor={eq?.caidos ?? 0}
              total={eq?.total}
              tono="caido"
              glifo="✕"
              clave="eq-caidos"
              href="/dispositivos?estado=3"
            />
            <Kpi
              titulo="Caída parcial"
              valor={eq?.parcial ?? 0}
              total={eq?.total}
              tono="parcial"
              glifo="!"
              clave="eq-parcial"
              href="/dispositivos?estado=2"
            />
            <Kpi
              titulo="Sin datos"
              valor={eq?.desconocidos ?? 0}
              total={eq?.total}
              tono="desconocido"
              glifo="?"
              clave="eq-desc"
              href="/dispositivos?estado=0"
            />
            <Kpi
              titulo="Arriba"
              valor={eq?.arriba ?? 0}
              total={eq?.total}
              tono="up"
              glifo="✓"
              clave="eq-arriba"
              href="/dispositivos?estado=1"
            />
          </div>
        </section>

        {/* 4 · Lo que está pasando. Dos columnas en escritorio, apiladas en
            celular con las caídas arriba: es lo urgente. */}
        <div class="grid gap-4 lg:grid-cols-2">
          <section class="tarjeta flex flex-col overflow-hidden" aria-labelledby="t-caidas">
            <header class="border-borde flex items-center justify-between gap-2 border-b px-3 py-2">
              <h2 id="t-caidas" class="text-sm font-semibold">Caídas recientes</h2>
              <span class="text-tenue text-2xs cifra">
                <span data-vivo="caidas-abiertas">{numero(resumen?.caidas_abiertas ?? 0)}</span>{' '}
                abiertas ·{' '}
                <span data-vivo="caidas-24h">{numero(resumen?.caidas_24h ?? 0)}</span> en 24 h
              </span>
            </header>
            {/* El id lo usa el refresco en vivo para reemplazar sólo esto. */}
            <div id="lista-caidas" class="min-h-[6rem]">
              <ListaCaidas caidas={caidas} vacio="Ninguna caída en el histórico. Buena noticia." />
            </div>
          </section>

          <section class="tarjeta flex flex-col overflow-hidden" aria-labelledby="t-mapas">
            <header class="border-borde flex items-center justify-between gap-2 border-b px-3 py-2">
              <h2 id="t-mapas" class="text-sm font-semibold">Mapas con problemas</h2>
              <a href="/mapas" class="text-acento-txt text-2xs font-semibold no-underline hover:underline">
                Ver los {numero(mapas.length)}
              </a>
            </header>

            {mapasRotos.length === 0 ? (
              <p class="text-tenue px-3 py-6 text-center text-xs">
                Ningún mapa con equipos caídos.
              </p>
            ) : (
              <ul class="divide-borde divide-y">
                {mapasRotos.map((m) => (
                  <li>
                    <a
                      href={`/mapas/${m.id}`}
                      class="hover:bg-panel-2 flex items-center gap-3 px-3 py-2 no-underline"
                    >
                      <span class="min-w-0 flex-1 truncate text-sm font-medium">{m.nombre}</span>
                      <span class="flex shrink-0 items-center gap-1.5">
                        {m.caidos > 0 && (
                          <span class="pildora pildora-caido">
                            <span class="glifo" aria-hidden="true">✕</span>
                            <span>{m.caidos}</span>
                            <span class="sr-only">caídos</span>
                          </span>
                        )}
                        {m.parcial > 0 && (
                          <span class="pildora pildora-parcial">
                            <span class="glifo" aria-hidden="true">!</span>
                            <span>{m.parcial}</span>
                            <span class="sr-only">en caída parcial</span>
                          </span>
                        )}
                        <span class="text-tenue text-2xs cifra w-14 text-right">
                          {porcentaje(m.arriba, m.equipos)} ok
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>

        {/* 5 · Los que se cayeron más recientemente, con nombre y apellido. */}
        {peores && peores.filas.length > 0 && (
          <section class="tarjeta overflow-hidden" aria-labelledby="t-peores">
            <header class="border-borde flex items-center justify-between gap-2 border-b px-3 py-2">
              <h2 id="t-peores" class="text-sm font-semibold">Los últimos en caer</h2>
              {peores.total > peores.filas.length && (
                <a
                  href="/dispositivos?estado=3"
                  class="text-acento-txt text-2xs font-semibold no-underline hover:underline"
                >
                  Ver los {numero(peores.total)}
                </a>
              )}
            </header>
            <ul class="divide-borde divide-y">
              {peores.filas.map((d) => (
                <li>
                  <a
                    href={`/dispositivos/${d.id}`}
                    class="hover:bg-panel-2 flex items-center gap-3 px-3 py-2 no-underline"
                  >
                    <Pildora estado={d.status} compacta />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm font-medium">{d.nombre}</span>
                      {d.direcciones.length > 0 && (
                        <span class="text-tenue text-2xs block truncate font-mono">
                          {d.direcciones.join(' · ')}
                        </span>
                      )}
                    </span>
                    <Antiguedad estado={d.status} desde={d.estado_desde} class="shrink-0" />
                    <span class="text-tenue text-2xs cifra hidden shrink-0 sm:inline">
                      {d.services_down}/{d.services_total} sondas
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* 6 · Contexto. Deliberadamente al final y en gris. */}
        <section aria-labelledby="t-inventario" class="tarjeta p-3">
          <h2 id="t-inventario" class="text-tenue text-2xs mb-2 font-semibold tracking-wide uppercase">
            Inventario
          </h2>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-4">
            {[
              ['Servicios monitoreados', resumen?.servicios.total ?? 0, 'sv-total'],
              ['Servicios caídos', resumen?.servicios.caidos ?? 0, 'sv-caidos'],
              ['Enlaces', resumen?.enlaces ?? 0, 'enlaces'],
              ['Mapas', resumen?.mapas ?? 0, 'mapas'],
            ].map(([t, v, clave]) => (
              <div>
                <dt class="text-tenue text-2xs">{t}</dt>
                <dd class="cifra text-lg font-semibold tabular-nums" data-vivo={clave as string}>
                  {numero(v as number)}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    )
  }
</Base>
