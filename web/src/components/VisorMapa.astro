---
import type { ElementoMapa, EnlacesFuera, ResumenSubmapa, TraficoEnlace } from '@/lib/consultas';
import {
  ALTO_LINEA,
  ALTO_LINEA_NODO,
  TAMANIO_NODO,
  construirLienzo,
  medioRecuadro,
} from '@/lib/mapa';
import { juegoDeIconos, medidasDeIconos } from '@/lib/iconos';
import { fabricante } from '@/lib/oui';
import { metaEstado, ESTADOS } from '@/lib/estado';
import { ANTIGUEDADES } from '@/lib/antiguedad';
import { duracion, numero, porcentaje } from '@/lib/formato';
import { VENTANAS } from '@/lib/ventanas';
import TarjetaNodo from '@/components/TarjetaNodo.astro';

interface Props {
  mapaId: number;
  nombre: string;
  elementos: ElementoMapa[];
  /** Estado y recuentos de cada submapa que aparece en este mapa. */
  submapas?: ReadonlyMap<number, ResumenSubmapa>;
  /** Clasificación de los enlaces que no se pueden dibujar acá. */
  fuera?: EnlacesFuera;
  /** Última medición de tráfico por enlace. Ver `traficoDeMapa`. */
  trafico?: ReadonlyMap<number, TraficoEnlace>;
  /**
   * ¿Esta persona puede acomodar los nodos?
   *
   * Lo decide el servidor con `lib/roles`, y de eso depende que el script de
   * arrastre siquiera se cargue. La comprobación que IMPORTA está igual en el
   * endpoint: esto ahorra bytes y evita ofrecer algo que no se va a poder
   * hacer, pero no es la barrera.
   */
  editable?: boolean;
  /** Cuántos nodos de este mapa ya tienen posición puesta a mano. */
  movidos?: number;
  /** Días de historia disponibles, para clasificar la vida. Ver `lib/vida`. */
  alcanceDias?: number;
  /** Qué capa está mirando. La elige la página por la URL. */
  capa?: 'activos' | 'dudosos' | 'todo';
  /**
   * Resaltar los que se CAYERON dentro de esta ventana, en horas.
   *
   * 🔴 RESALTA Y ATENÚA, no esconde. Y es una decisión, no una comodidad.
   *
   *    La petición fue «filtrá los equipos que dejaron de andar en las últimas
   *    X horas». En una lista, filtrar es lo correcto. En un mapa **es lo peor
   *    que se puede hacer**, porque tira justamente lo único que el mapa
   *    aporta sobre la lista: el LUGAR.
   *
   *    Seis equipos caídos son seis renglones. Seis equipos caídos colgando
   *    todos del mismo nodo son un diagnóstico — y eso sólo se ve si el resto
   *    del mapa sigue dibujado, apagado, atrás. Escondiéndolos quedarían seis
   *    puntos flotando en un vacío que no explica nada.
   */
  ventanaH?: number | null;
  /** Cuántos elementos quedaron afuera por esa capa. Se dice SIEMPRE. */
  ocultos?: number;
}

const {
  mapaId, nombre, elementos, submapas = new Map(), fuera, trafico,
  editable = false, movidos = 0, alcanceDias, capa = 'todo', ocultos = 0,
  ventanaH = null,
} = Astro.props;

/**
 * Las tres capas, con su enlace. Vive acá y no en la página porque es lo que
 * se DIBUJA; la página sólo decide cuál está activa.
 */
/**
 * Arma un enlace cambiando UN parámetro y conservando los demás.
 *
 * 🔴 Antes acá decía `href={`?capa=${c.valor}`}`, y eso BORRA todo lo demás.
 *    Con un solo filtro no se notaba. Al agregar la ventana de caída se
 *    convierte en un defecto de verdad: elegís «cayó en 6 h», tocás «Todo»
 *    para ver también las bajas, y la ventana se evapora sin decir nada.
 *
 *    Un valor vacío BORRA el parámetro en vez de dejarlo colgando: una URL con
 *    `?desde=` no se distingue a simple vista de una con el filtro puesto, y
 *    estas URLs están hechas para pegarse en un chat.
 */
function conParam(clave: string, valor: string): string {
  const u = new URLSearchParams(Astro.url.search);
  if (valor === '') u.delete(clave);
  else u.set(clave, valor);
  const q = u.toString();
  return q ? `?${q}` : Astro.url.pathname;
}

const CAPAS = [
  { valor: 'activos', texto: 'En servicio' },
  { valor: 'dudosos', texto: '+ dudosos' },
  { valor: 'todo', texto: 'Todo' },
] as const;

// El tamaño natural de cada icono se mide ANTES de armar la geometría: sin él
// no se puede aplicar `image_scale`, que es un porcentaje sobre ese tamaño. Se
// leen sólo los encabezados de los archivos distintos del mapa, y quedan en
// caché para las cargas siguientes.
// 🔴 Se miden los DOS escalones de la cadena. Antes se medía sólo `e.icon`, y
//    ahora que el nodo puede caer al icono de su TIPO, ese archivo también
//    necesita su tamaño natural: sin la medida, `cajaDeIcono` no puede aplicar
//    `image_scale` y el dibujo saldría en el cuadro por omisión. Son ~5
//    archivos distintos más, y quedan en caché.
const medidas = await medidasDeIconos(
  elementos.flatMap((e) => [e.icon, e.icon_tipo]),
);

const lienzo = construirLienzo(elementos, submapas, medidas, { trafico, alcanceDias });

// Los que se muestran pero atenuados. Los de baja ni llegan hasta acá: la
// página ya los sacó, para que el encuadre no los tenga en cuenta.
const dudosos = lienzo.nodos.filter((n) => n.vida === 'dudoso').length;

// Cuántos nodos son residuo. Es lo que justifica —o no— ofrecer atenuarlos.
const residuos = lienzo.nodos.filter((n) => n.antiguedad === 'residuo').length;
const recientes = lienzo.nodos.filter((n) => n.antiguedad === 'reciente').length;

// 🔴 La pista del pictograma de repuesto, con TODO lo que se sabe del equipo.
//
//    Antes iba sólo el nombre del nodo. Alcanza cuando el ISP nombra por
//    función (`SW_DC_01`, `CPE_Bahia_0031`), pero deja afuera a los cientos
//    que se llaman por su ubicación (`Dalmata M5.8`, `Oso-e-Bruck`): ésos
//    caían al genérico, la cajita gris.
//
//    Ahora se suman dos cosas que ya están en la base y no se usaban:
//
//      · el nombre del TIPO de equipo
//      · el FABRICANTE deducido de la MAC — 557 equipos, ver `lib/oui`
//
//    Con la marca, un Ubiquiti anónimo deja de ser una caja y pasa a dibujarse
//    como lo que casi siempre es en esta red. No es certeza, es la mejor
//    conjetura disponible — y por eso va SEPARADA de la pista, no pegada:
//    `claveRepuestoPorMarca` corre la pista primero y sólo mira el fabricante
//    si ésta no dijo nada. La pista la escribió una persona mirando el equipo;
//    la marca es una inferencia sobre tres bytes de MAC. Gana la persona.
const marcaPorElemento = new Map<number, string>();
for (const e of elementos) {
  const f = fabricante(e.macs);
  if (f) marcaPorElemento.set(e.element_id, f.nombre);
}
const tipoPorElemento = new Map<number, string>();
for (const e of elementos) {
  if (e.tipo_nombre) tipoPorElemento.set(e.element_id, e.tipo_nombre);
}

const { simbolos, porNodo } = await juegoDeIconos(
  lienzo.nodos.map((n) => ({
    id: n.id,
    icono: n.icono,
    pista: [
      n.kind === 'submap' ? 'submapa' : n.kind === 'network' ? 'red' : '',
      n.nombre,
      tipoPorElemento.get(n.id) ?? '',
    ]
      .filter(Boolean)
      .join(' '),
    marca: marcaPorElemento.get(n.id) ?? null,
  })),
);

/** Desplazamiento de la primera línea de base de una ficha de anotación. */
const PRIMERA_BASE = 10;

const vb = `${lienzo.vista.x} ${lienzo.vista.y} ${lienzo.vista.ancho} ${lienzo.vista.alto}`;

// Cuántos enlaces quedaron sin trazar, y por qué.
// `faltan` es la verdad de la pantalla: sale de comparar lo que trajo el mapa
// con lo que realmente se dibujó. La clasificación viene de la base. Si las dos
// no cierran, la diferencia se declara como "otro motivo" en vez de esconderse:
// una cuenta que no cuadra es información, no algo que tapar.
const faltan = lienzo.enlacesTotales - lienzo.enlaces.length;
const enOtroMapa = Math.min(fuera?.otroMapa ?? 0, faltan);
const rotos = Math.min(fuera?.rotos ?? 0, Math.max(faltan - enOtroMapa, 0));
const sinClasificar = Math.max(faltan - enOtroMapa - rotos, 0);
const destinos = enOtroMapa > 0 ? (fuera?.destinos ?? []) : [];
---

<div
  class="border-borde bg-panel relative flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border"
  data-visor
  data-mapa-id={mapaId}
  data-editable={editable ? 'si' : undefined}
  data-resaltando={ventanaH != null ? 'si' : undefined}
  {...(editable ? { 'data-offset-nodo': String(TAMANIO_NODO / 2) } : {})}
>
  {/* ── Controles ─────────────────────────────────────────────────────── */}
  <div class="pointer-events-none absolute top-2 right-2 z-10 flex flex-col items-end gap-2">
    <div
      class="border-borde bg-panel/90 pointer-events-auto flex overflow-hidden rounded-lg border shadow-sm backdrop-blur"
      role="group"
      aria-label="Zoom del mapa"
    >
      <button
        type="button"
        data-zoom="1"
        class="hover:bg-panel-2 grid size-9 place-items-center text-lg leading-none"
        aria-label="Acercar">+</button
      >
      <button
        type="button"
        data-zoom="-1"
        class="border-borde hover:bg-panel-2 grid size-9 place-items-center border-l text-lg leading-none"
        aria-label="Alejar">−</button
      >
      <button
        type="button"
        data-ajustar
        class="border-borde hover:bg-panel-2 text-2xs grid h-9 place-items-center border-l px-2.5 font-semibold"
        aria-label="Ajustar el mapa a la vista">Ajustar</button
      >
    </div>
    <span
      class="border-borde bg-panel/90 text-2xs text-tenue rounded border px-1.5 py-0.5 font-mono tabular-nums backdrop-blur"
      data-nivel-zoom
      aria-live="off">100 %</span
    >

    {/* ── Acomodar los nodos ─────────────────────────────────────────────────
        Sólo para quien puede editar. Para el resto ni aparece — y aunque
        apareciera, el endpoint contesta 403. */}
    {
      editable && (
        <div class="pointer-events-auto flex flex-col items-end gap-1">
          {/* 🔴 La pista NO es opcional. Mover exige Ctrl (o ⌘) a propósito,
              y un gesto con modificador que no está escrito en ningún lado es
              un gesto que nadie va a descubrir. Va acá arriba, siempre
              visible, y sólo para quien puede usarlo. */}
          <p class="border-borde bg-panel/90 text-2xs text-tenue rounded border px-2 py-1 backdrop-blur">
            <kbd class="border-borde bg-panel-2 text-texto rounded border px-1 font-sans">Ctrl</kbd>
            {' '}o{' '}
            <kbd class="border-borde bg-panel-2 text-texto rounded border px-1 font-sans">⌘</kbd>
            {' '}+ arrastrar para acomodar
            <span class="text-tenue/70 block">en el celular, mantené apretado</span>
          </p>
          <span
            class="border-borde bg-panel/90 text-2xs rounded border px-2 py-1 backdrop-blur transition-[opacity,color] duration-200 empty:opacity-0 data-[tono=error]:border-caido/60 data-[tono=error]:text-caido-txt data-[tono=guardado]:text-arriba-txt data-[tono=guardando]:text-tenue"
            data-estado-guardado
            aria-live="polite"
          />
          {movidos > 0 && (
            <button
              type="button"
              data-restablecer
              class="border-borde bg-panel/90 hover:bg-panel-2 text-2xs cursor-pointer rounded border px-2 py-1 backdrop-blur transition-colors duration-150 disabled:opacity-50"
              title={`${movidos} ${movidos === 1 ? 'nodo tiene' : 'nodos tienen'} una posición puesta a mano. Esto los devuelve a la que trae The Dude.`}
            >
              Volver al original · {movidos}
            </button>
          )}
        </div>
      )
    }

    {/* ── Atenuar residuos ───────────────────────────────────────────────────
        🔴 Sale sólo si hay residuos, y el número va en el propio botón.

        Es el control que sostiene todo el eje de antigüedad en el mapa: sin él,
        atenuar sería una decisión que el panel toma por el operador y que no se
        puede deshacer. Con él es una lente que se prende y se apaga — y el
        número de al lado ya cuenta la historia aunque nunca lo toques.

        Empieza ENCENDIDO porque el defecto que se viene a arreglar es
        exactamente que los rojos permanentes enseñan a ignorar el rojo. */}
    {
      residuos > 0 && (
        <button
          type="button"
          data-atenuar
          aria-pressed="true"
          class="border-borde bg-panel/90 text-2xs aria-pressed:border-acento aria-pressed:text-acento-txt pointer-events-auto flex items-center gap-1.5 rounded-lg border px-2 py-1 font-medium backdrop-blur"
          title="Los que llevan más de un año en el mismo estado casi seguro son bajas que nadie sacó del monitoreo. Atenuarlos deja ver lo que sí está pasando."
        >
          <span class="rampa" data-antiguedad="residuo" aria-hidden="true" />
          {/* Una sola expresión: partido en dos líneas, JSX mete un espacio en
              el medio y en pantalla se leía «Atenuar 6 residuo s». */}
          <span>{`Atenuar ${numero(residuos)} residuo${residuos === 1 ? '' : 's'}`}</span>
        </button>
      )
    }

    {/* ── Capas: qué parte de la realidad se está mirando ──────────────────
        Son ENLACES y no botones: el filtrado ocurre en el servidor —para que
        el encuadre del mapa se recalcule— y un enlace es lo que se puede
        pegar en un chat. Un botón con JS daría lo mismo en pantalla y no se
        podría compartir.

        🔴 Y se dibuja SIEMPRE que haya algo oculto, aunque estés en «Todo»:
           un mapa recortado que no dice que está recortado es peor que el
           mapa sucio. Toda la idea es no mentir. */}
    {
      (ocultos > 0 || capa !== 'activos') && (
        <nav
          aria-label="Qué equipos se muestran"
          class="border-borde bg-panel/90 pointer-events-auto flex items-center gap-0.5 rounded-lg border p-0.5 backdrop-blur"
        >
          {CAPAS.map((c) => (
            <a
              href={conParam('capa', c.valor)}
              aria-current={c.valor === capa ? 'page' : undefined}
              class:list={[
                'text-2xs rounded-md px-2 py-1 font-medium no-underline transition-colors',
                c.valor === capa
                  ? 'bg-acento-bg text-acento-txt'
                  : 'text-tenue hover:bg-panel-2 hover:text-tinta',
              ]}
            >
              {c.texto}
            </a>
          ))}
          {ocultos > 0 && (
            <a
              href="/inventario"
              class="text-tenue hover:text-tinta px-1.5 tabular-nums"
              title="Equipos sin señales de vida que no se están dibujando. Ver el inventario completo, con fechas y motivos."
            >
              {`−${numero(ocultos)}`}
            </a>
          )}
        </nav>
      )
    }

    {/* ── Resaltar lo que se cayó recién ────────────────────────────────────
        🔴 Va SIEMPRE, no sólo cuando ya hay algo resaltado. Es la única forma
           de que alguien descubra que la función existe: un control que
           aparece recién cuando ya lo usaste no lo usa nadie la primera vez.

           Y el número de cada ventana no se muestra acá, a diferencia de
           `/caidas`: contarlos exigiría recorrer los elementos por cada
           ventana en cada dibujo del mapa, y el mapa se dibuja mucho. El que
           quiere los números los tiene en la lista, a un clic. */}
    <nav
      aria-label="Resaltar los que se cayeron recién"
      class="border-borde bg-panel/90 pointer-events-auto flex items-center gap-0.5 rounded-lg border p-0.5 backdrop-blur"
    >
      <span class="text-tenue px-1.5 text-2xs">Cayó en</span>
      {VENTANAS.map((v) => {
        const puesta = v.horas == null ? ventanaH == null : ventanaH === v.horas;
        return (
          <a
            href={conParam('desde', v.horas == null ? '' : v.clave)}
            title={v.ayuda}
            aria-current={puesta ? 'page' : undefined}
            class:list={[
              'text-2xs rounded-md px-2 py-1 font-medium no-underline transition-colors',
              puesta ? 'bg-acento-bg text-acento-txt' : 'text-tenue hover:bg-panel-2 hover:text-tinta',
            ]}
          >
            {v.texto}
          </a>
        );
      })}
    </nav>
  </div>

  {/* ── Referencia de estados ─────────────────────────────────────────────
      No es decoración: es lo que permite leer el mapa sin depender del color.
      Cada estado tiene glifo, trazo y tono distintos. */}
  <details
    class="border-borde bg-panel/90 absolute bottom-2 left-2 z-10 rounded-lg border text-xs shadow-sm backdrop-blur open:pb-1"
  >
    <summary class="cursor-pointer list-none px-2.5 py-1.5 font-semibold select-none">
      Referencia
    </summary>
    <ul class="space-y-1 px-2.5 pb-1">
      {
        ESTADOS.map((e) => (
          <li class="flex items-center gap-2">
            <svg width="34" height="16" viewBox="0 0 34 16" aria-hidden="true" class="shrink-0">
              <g data-estado={e.valor} class="nodo-mapa">
                <circle class="aro" cx="9" cy="8" r="6" />
                <g class="marca-estado" transform="translate(24,8)">
                  <circle class="fondo" r="6" />
                  <text class="glifo" y="3">{e.glifo}</text>
                </g>
              </g>
            </svg>
            <span class="text-tenue">{e.etiqueta}</span>
          </li>
        ))
      }
    </ul>

    {/* ── Y el segundo eje ─────────────────────────────────────────────────
        🔴 Va SEPARADO de los estados, con su propio título, y eso es
           deliberado: la antigüedad NO es un quinto estado. Un residuo está
           caído, con el mismo glifo y el mismo trazo que cualquier caído. Lo
           que cambia es cuánta atención pide, y eso se dibuja atenuando o
           realzando, nunca cambiando lo que el nodo dice que es.

           Si esta referencia mezclara las dos listas, en tres semanas alguien
           estaría diciendo «está en residuo» como si fuera un estado, y el
           panel habría empezado a contradecir a The Dude. */}
    <div class="border-borde/70 mt-1 border-t px-2.5 pt-1 pb-1">
      <p class="text-2xs text-tenue mb-1 font-semibold">Y hace cuánto que está así</p>
      <ul class="space-y-1">
        {
          ANTIGUEDADES.map((a) => (
            <li class="flex items-center gap-2">
              <svg width="34" height="16" viewBox="0 0 34 16" aria-hidden="true" class="shrink-0">
                <g data-estado="3" data-antiguedad={a.clave} class="nodo-mapa">
                  <circle class="aro" cx="9" cy="8" r="6" />
                  <g class="marca-estado" transform="translate(24,8)">
                    <circle class="fondo" r="6" />
                    <text class="glifo" y="3">
                      ✕
                    </text>
                  </g>
                </g>
              </svg>
              <span class="text-tenue inline-flex items-center gap-1.5" title={a.explica}>
                <span class="rampa" data-antiguedad={a.clave} aria-hidden="true" />
                {a.etiqueta}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="text-2xs text-tenue mt-1 max-w-[15rem] opacity-80">
        Sigue siendo el mismo estado. Lo que cambia es cuánta atención pide.
      </p>
    </div>
  </details>

  {
    lienzo.sinPosicion > 0 && (
      <p class="border-parcial/50 bg-parcial-bg text-parcial-txt text-2xs absolute bottom-2 left-1/2 z-10 -translate-x-1/2 rounded-lg border px-2 py-1">
        {lienzo.sinPosicion} elemento{lienzo.sinPosicion === 1 ? '' : 's'} sin coordenadas, acomodado
        {lienzo.sinPosicion === 1 ? '' : 's'} abajo
      </p>
    )
  }

  {/* ── El lienzo ──────────────────────────────────────────────────────── */}
  <svg
    class="lienzo-mapa min-h-[24rem] flex-1"
    viewBox={vb}
    preserveAspectRatio="xMidYMid meet"
    role="group"
    aria-label={`Topología del mapa ${nombre}: ${lienzo.nodos.length} elementos y ${lienzo.enlaces.length} enlaces. Usá Tab para recorrer los nodos.`}
    tabindex="0"
    data-svg-mapa
  >
    <defs>
      {
        [...simbolos.entries()].map(([clave, ico]) => (
          <symbol id={`ico-${clave}`} viewBox={ico.viewBox} set:html={ico.cuerpo} />
        ))
      }
    </defs>

    <g class="capa-mapa" data-capa>
      {/* Los enlaces van primero para que queden por debajo de los nodos. */}
      <g data-enlaces>
        {
          lienzo.enlaces.map((l) => (
            <line
              class="enlace-mapa"
              data-estado={l.estado}
              data-de={l.de}
              data-a={l.a}
              x1={l.x1}
              y1={l.y1}
              x2={l.x2}
              y2={l.y2}
              stroke-width={l.ancho}
            >
              <title>
                {l.nombre ?? 'Enlace'}
                {l.detalle ? ` — ${l.detalle}` : ''} — {metaEstado(l.estado).etiqueta}
              </title>
            </line>
          ))
        }
      </g>

      {/* Fichas de anotación (`static`): la configuración de VLAN de un puerto.
          Van entre los enlaces y los nodos para que un nodo nunca quede tapado.
          Los enlaces SÍ se enganchan a ellas — ver el comentario en `Rotulo`. */}
      <g data-rotulos>
        {
          lienzo.rotulos.map((r) => (
            <text class="rotulo-mapa" x={r.x} y={r.y}>
              <title>{r.lineas.join(' · ')}</title>
              {/* La primera baja menos: la coordenada del origen es el borde
                  superior del bloque, no la línea de base del texto. */}
              {r.lineas.map((linea, i) => (
                <tspan x={r.x} dy={i === 0 ? PRIMERA_BASE : ALTO_LINEA}>
                  {linea}
                </tspan>
              ))}
            </text>
          ))
        }
      </g>

      <g data-nodos>
        {
          lienzo.nodos.map((n) => {
            const m = metaEstado(n.estado);
            const ips = n.direcciones.length ? ` — ${n.direcciones.join(', ')}` : '';
            const que =
              n.kind === 'submap' ? 'Submapa' : n.kind === 'network' ? 'Red' : 'Equipo';
            const Nodo = n.href ? 'a' : 'g';
            // 🔴 La antigüedad entra en el nombre accesible, no sólo en el
            //    dibujo. Atenuar es un canal visual y nada más: quien usa
            //    lector de pantalla tiene que escuchar la misma distinción que
            //    ve el que mira, o el eje entero no existe para esa persona.
            const cuanto =
              n.edad_s != null ? ` — así desde hace ${duracion(n.edad_s)}` : '';
            // El recuadro ya no es un cuadrado fijo: envuelve al icono, que
            // ahora mide lo que pidió `image_scale` y con la proporción del
            // archivo. La marca de estado y la etiqueta cuelgan de sus bordes.
            const caja = medioRecuadro(n);
            // 🔴 «Sin señales» entra en el NOMBRE ACCESIBLE, no sólo en la
            //    opacidad. Atenuar es un canal visual y nada más: quien usa
            //    lector de pantalla tiene que escuchar la misma advertencia, o
            //    para esa persona un nodo dudoso suena igual que uno sano.
            const aviso = n.vida === 'dudoso' ? ' — sin señales de vida recientes' : '';
            // `data-resalte`: el servidor decide quién entra en la ventana de
            // caída, el CSS sólo lo dibuja. Se MARCA, no se filtra — ver
            // `ventanaH` en las props.
            //
            // 🔴 Y esta explicación va acá y no entre los atributos del nodo,
            //    porque un comentario JSX entre atributos NO COMPILA y el error
            //    que tira apunta a la etiqueta de cierre, cien líneas más
            //    abajo. Es la cuarta vez en este proyecto.
            return (
              <Nodo
                class="nodo-mapa"
                data-estado={n.estado}
                data-id={n.id}
                data-antiguedad={n.antiguedad ?? undefined}
                data-edad={n.edad_s != null ? Math.round(n.edad_s) : undefined}
                data-resalte={
                  ventanaH != null &&
                  n.estado !== 1 &&
                  n.estado !== 2 &&
                  n.edad_s != null &&
                  n.edad_s <= ventanaH * 3600
                    ? 'si'
                    : undefined
                }
                data-dev={n.deviceId ?? undefined}
                data-vida={n.vida ?? undefined}
                href={n.href ?? undefined}
                tabindex={n.href ? 0 : undefined}
                role={n.href ? 'link' : 'img'}
                aria-label={`${que} ${n.nombre} — ${m.etiqueta}${ips}${cuanto}${aviso}`}
                data-rotulo={`${que} ${n.nombre}`}
                data-ips={ips}
                transform={`translate(${n.cx} ${n.cy})`}
              >
                <title>
                  {n.nombre} — {m.etiqueta}
                  {ips}
                  {cuanto}
                  {n.vidaMotivo && n.vida !== 'activo' ? `\n${n.vidaMotivo}` : ''}
                </title>

                <rect
                  class="halo"
                  x={-caja.x - 6}
                  y={-caja.y - 6}
                  width={caja.x * 2 + 12}
                  height={caja.y * 2 + 12}
                  rx="14"
                />
                <rect
                  class="aro"
                  x={-caja.x}
                  y={-caja.y}
                  width={caja.x * 2}
                  height={caja.y * 2}
                  rx="9"
                />

                {/* SVG incrustado o PNG servido del disco, según el formato
                    real del icono de The Dude. Ver `Pincel`. */}
                {(() => {
                  const p = porNodo.get(n.id);
                  const box = {
                    x: -n.ancho / 2,
                    y: -n.alto / 2,
                    width: n.ancho,
                    height: n.alto,
                  };
                  // `preserveAspectRatio`: los iconos de Ubiquiti no son
                  // cuadrados y sin esto se estiran, con lo que un nanostation
                  // parece otra cosa.
                  //
                  // 🔴 Y por eso la caja ahora TIENE la proporción del archivo.
                  //    Con el cuadro de 22×22 que había antes, `meet` metía una
                  //    foto de 467×92 dentro del cuadrado: salía de 22×4, una
                  //    astilla. La proporción correcta es la mitad del arreglo.
                  //
                  // Sin carga diferida a propósito: un mapa de 400 nodos usa
                  // apenas 21 URLs distintas, así que el navegador hace 21
                  // peticiones y reusa. No hay nada que diferir.
                  return p?.tipo === 'imagen' ? (
                    <image href={p.url} {...box} preserveAspectRatio="xMidYMid meet" />
                  ) : (
                    <use href={`#ico-${p?.clave ?? 'r-generico'}`} {...box} class="text-tinta" />
                  );
                })()}

                {/* La marca de estado: forma + glifo. Es la redundancia que
                    hace legible el mapa sin distinguir colores. */}
                <g class="marca-estado" transform={`translate(${caja.x - 1} ${-caja.y + 1})`}>
                  <circle class="fondo" r="7" />
                  <text class="glifo" y="3.2" data-glifo>
                    {m.glifo}
                  </text>
                </g>

                {/* El rótulo de The Dude, ya resuelto y multilínea.
                    Antes iba en un solo `<text>`: el `\r\n` del origen colapsa
                    a un espacio y el recorte se comía la segunda línea, así que
                    de `[Device.Name]\r\n[Device.FirstAddress]` se leía
                    «[Device.Name] [Dev…» y la dirección no aparecía nunca.
                    La primera línea es el nombre y va destacada; las que siguen
                    son el detalle y van más chicas, para que 400 nodos con dos
                    renglones cada uno sigan siendo un mapa y no una pared. */}
                <text class="etiqueta" y={caja.y + 14} text-anchor="middle">
                  {n.lineas.map((linea, i) => (
                    <tspan
                      x="0"
                      dy={i === 0 ? 0 : ALTO_LINEA_NODO}
                      class={i === 0 ? undefined : 'secundaria'}
                    >
                      {linea}
                    </tspan>
                  ))}
                </text>
              </Nodo>
            );
          })
        }
      </g>
    </g>
  </svg>

  {/* ── Qué se dibujó y qué no ──────────────────────────────────────────────
      Declarar la diferencia no es un detalle: en Segmentos hay 308 enlaces y sólo
      107 se pueden trazar. Sin esta línea, el operador lee un mapa mucho menos
      conectado de lo que es la red, y no tiene forma de darse cuenta. */}
  <div class="border-borde text-2xs border-t">
    <p class="text-tenue flex flex-wrap items-center gap-x-4 gap-y-0.5 px-3 py-1.5">
      <span>Arrastrá para mover · rueda o pellizco para acercar</span>
      <span class="hidden lg:inline">Con el foco en el mapa: flechas mueven, + − acercan, 0 ajusta</span>
      <span class="ml-auto tabular-nums">
        {numero(lienzo.nodos.length)} nodos ·{' '}
        {
          faltan > 0 ? (
            <strong class="text-tinta font-semibold">
              {numero(lienzo.enlacesTotales)} enlaces, {numero(lienzo.enlaces.length)} dibujados
            </strong>
          ) : (
            <>{numero(lienzo.enlaces.length)} enlaces</>
          )
        }
      </span>
    </p>

    {
      faltan > 0 && (
        <p class="border-borde/70 text-tenue flex flex-wrap items-center gap-x-3 gap-y-1 border-t px-3 py-1.5">
          <span class="text-parcial-txt font-mono font-bold" aria-hidden="true">
            !
          </span>

          {enOtroMapa > 0 && (
            <span>
              <strong class="font-semibold">{numero(enOtroMapa)}</strong> conectan con equipos
              dibujados en otros mapas
            </span>
          )}

          {/* Lo que faltaba se vuelve navegación: el otro extremo existe y
              sabemos exactamente dónde está. */}
          {destinos.map((d) => (
            <a
              href={`/mapas/${d.id}`}
              class="border-borde bg-panel-2 hover:border-acento hover:text-acento-txt rounded-full border px-2 py-0.5 font-medium no-underline"
            >
              {d.nombre}
              <span class="text-tenue tabular-nums"> · {numero(d.enlaces)}</span>
              <span class="sr-only">
                {d.enlaces === 1 ? ' enlace termina' : ' enlaces terminan'} en ese mapa
              </span>
            </a>
          ))}

          {rotos > 0 && (
            <span title="Referencias colgadas del propio The Dude: el elemento del otro extremo ya no está en la base.">
              <strong class="font-semibold">{numero(rotos)}</strong> tienen extremos que ya no
              existen
            </span>
          )}

          {sinClasificar > 0 && (
            <span>
              <strong class="font-semibold">{numero(sinClasificar)}</strong> sin dibujar por otro
              motivo
            </span>
          )}
        </p>
      )
    }

    {/* ── Rótulos que piden datos que no tenemos ──────────────────────────────
        Misma regla que arriba: el rótulo de The Dude es una plantilla y algunos
        de sus campos no se pueden resolver. En vez de escribir
        `[Interface.InBitRate]` en pantalla —o peor, un `0 Mbps` inventado— la
        línea se omite y el hueco se declara acá, con nombre y cantidad.

        🔴 Y con la COBERTURA al lado, que es lo que hacía falta. Este pie llegó
           a declarar «el panel no replica el tráfico» en 38 de los 40 mapas
           porque una medición vieja decía que casi ningún enlace tenía datos.
           Hoy 173 de 1.169 sí los tienen. El pie ahora cuenta lo que encontró
           EN ESTE DIBUJO —«N sin serie · M con dato»— así que no puede volver a
           envejecer: si mañana el ETL termina de replicar, el número sube solo.
           Ver `Hueco.resueltos`. */}
    {
      lienzo.huecos.length > 0 && (
        <p class="border-borde/70 text-tenue flex flex-wrap items-center gap-x-3 gap-y-1 border-t px-3 py-1.5">
          <span class="font-mono font-bold" aria-hidden="true">
            ?
          </span>
          <span>Rótulos que quedaron sin dato:</span>

          {lienzo.huecos.map((h) => (
            <span
              class="whitespace-nowrap"
              title={
                h.motivo === 'desconocida'
                  ? `${h.plantilla} — plantilla que el panel no reconoce; hay que agregarla`
                  : h.motivo === 'sin-dato'
                    ? `${h.plantilla} — el panel sabe leer este campo; lo que falta es el dato de estos elementos`
                    : `${h.plantilla} — campo conocido, sin origen en la base del panel`
              }
            >
              <strong class="font-semibold">{h.como}</strong>
              <span class="tabular-nums"> · {numero(h.veces)}</span>
              {/* La cobertura viva. Sin esto, «996» se lee como «no anda». */}
              {h.resueltos > 0 && (
                <span class="text-up-txt tabular-nums">
                  {' '}
                  · {numero(h.resueltos)} con dato ({porcentaje(h.resueltos, h.resueltos + h.veces)})
                </span>
              )}
              {h.motivo === 'desconocida' && (
                <span class="text-parcial-txt font-mono" aria-label="plantilla no reconocida">
                  {' '}
                  ‹?›
                </span>
              )}
            </span>
          ))}
        </p>
      )
    }

    {/* Cuántos nodos son alarma viva y cuántos son paisaje. Es la lectura que
        el mapa de The Dude no da y por la que existe todo este eje. */}
    {
      (recientes > 0 || residuos > 0) && (
        <p class="border-borde/70 text-tenue flex flex-wrap items-center gap-x-3 gap-y-1 border-t px-3 py-1.5">
          {recientes > 0 && (
            <span class="inline-flex items-center gap-1.5">
              <span class="rampa" data-antiguedad="reciente" aria-hidden="true" />
              <span>
                <strong class="text-tinta font-semibold tabular-nums">{numero(recientes)}</strong>{' '}
                cambiaron esta semana
              </span>
            </span>
          )}
          {residuos > 0 && (
            <span class="inline-flex items-center gap-1.5">
              <span class="rampa" data-antiguedad="residuo" aria-hidden="true" />
              <span>
                <strong class="font-semibold tabular-nums">{numero(residuos)}</strong> llevan más de
                un año igual
              </span>
            </span>
          )}
        </p>
      )
    }
  </div>

  <TarjetaNodo />
</div>

<script>
  import '@/scripts/visor-mapa';
  import '@/scripts/tarjeta-nodo';

  /**
   * 🔴 El arrastre se pide con `import()` DINÁMICO, y no es un capricho.
   *
   *    La primera versión era una etiqueta de script condicional en el cuerpo
   *    del componente —`{editable && …}`— con un comentario que decía que el
   *    código sólo le llegaba a quien puede editar. **Era mentira, y se
   *    comprobó midiendo**: Astro procesa los scripts de un componente en
   *    tiempo de COMPILACIÓN y los junta en el mismo paquete. La condición
   *    decidía si se escribía la etiqueta en el HTML, no qué bytes bajaba el
   *    navegador.
   *
   *    (Y de paso: dentro de un bloque de script no se puede escribir la
   *    etiqueta de cierre ni siquiera en un comentario. El parser corta ahí y
   *    el error que sale — «Expected ";" but found …» — apunta a otra línea.)
   *
   *    Bajando todo lo que servía la página a una cuenta de sólo lectura
   *    aparecían `api/posiciones`, `sendBeacon` y `nodo-arrastrado`.
   *
   *    No era un agujero —el módulo busca `[data-visor][data-editable]`, que
   *    el servidor no pone para esa cuenta, y el endpoint contesta 403 igual—
   *    pero una afirmación de seguridad que no se cumple es peor que no
   *    hacerla: la próxima decisión se toma creyéndola.
   *
   *    Con `import()` dentro de un `if`, Vite parte el módulo en su propio
   *    trozo y el navegador sólo lo pide si entra en la condición. Ahora la
   *    frase es verdad, y hay un test que la sostiene.
   */
  if (document.querySelector('[data-visor][data-editable]')) {
    import('@/scripts/mover-nodos');
  }
</script>

<style>
  /* ── Arrastrar ────────────────────────────────────────────────────────────
     El cursor es la única señal de que un nodo se puede mover: no hay tirador
     ni borde extra, porque en un mapa de 400 nodos cualquier adorno por nodo
     es ruido multiplicado por 400.

     🔴 `data-listo-mover` lo pone el script mientras Ctrl (o ⌘) está apretado.
        La mano NO puede estar siempre: mover exige el modificador, y un cursor
        que promete algo que no va a pasar es peor que ninguno. */
  :global([data-visor][data-editable][data-listo-mover] .nodo-mapa) {
    cursor: grab;
  }
  :global([data-visor][data-moviendo-nodo] .nodo-mapa) {
    cursor: grabbing;
  }

  /* El nodo agarrado se levanta un poco: la sombra y la escala dicen "esto
     está en tu mano". 1.08 y no más — a 1.2 tapa a sus vecinos justo cuando
     lo que estás haciendo es mirar dónde ponerlo. */
  :global(.nodo-arrastrado) {
    transform-box: fill-box;
    transform-origin: center;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.45));
  }
  :global(.nodo-arrastrado image),
  :global(.nodo-arrastrado use) {
    scale: 1.08;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Mientras se arrastra, el resto del mapa baja un punto para que la vista se
     quede en lo que se mueve. Es la única animación del lienzo. */
  :global([data-visor][data-moviendo-nodo] .nodo-mapa:not(.nodo-arrastrado)) {
    opacity: 0.55;
  }
  :global([data-visor] .nodo-mapa) {
    transition: opacity 160ms ease-out;
  }

  /* Un nodo DUDOSO: callado hace tiempo, pero no lo suficiente para darlo de
     baja. Se dibuja punteado y a media tinta.

     🔴 Punteado Y atenuado, no sólo atenuado. La opacidad sola se pierde en
        una pantalla de NOC con reflejo, y encima ya la usa el arrastre. El
        trazo discontinuo es un segundo canal que sobrevive al monocromo, al
        daltonismo y al brillo mal calibrado. Es la misma regla que la rampa de
        antigüedad: nunca un solo canal.

     La advertencia va además en el `aria-label` y en el globito, así que quien
     no ve el dibujo escucha lo mismo. */
  :global([data-visor] .nodo-mapa[data-vida='dudoso']) {
    opacity: 0.6;
  }
  :global([data-visor] .nodo-mapa[data-vida='dudoso'] .halo) {
    stroke-dasharray: 3 3;
    stroke-width: 1;
    stroke: currentColor;
    opacity: 0.5;
  }

  /* Marca discreta en los que alguien acomodó. Un punto, no un cartel: hay que
     poder ver de un vistazo qué se tocó sin que compita con el estado, que es
     lo que de verdad importa en un mapa de monitoreo. */
  :global([data-visor][data-editable] .nodo-mapa[data-movido]) {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-visor] .nodo-mapa) {
      transition: none;
    }
    :global(.nodo-arrastrado image),
    :global(.nodo-arrastrado use) {
      scale: 1;
    }
  }
</style>
