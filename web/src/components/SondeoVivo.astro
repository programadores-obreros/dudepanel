---
import type { Ping, Puertos, Resultado, Snmp, Traza } from '@/lib/sonda';

/**
 * Ping, puertos y traceroute EN VIVO desde la ficha del equipo.
 *
 * ── Qué agrega, sobre todo lo demás que ya está en esta página ──────────────
 *
 * Todo lo que rodea a este bloque es un espejo: muestra lo que The Dude midió
 * hace hasta 30 segundos. Esto pregunta AHORA. Son dos cosas distintas y la
 * segunda es la que sirve cuando alguien llama diciendo «se me cayó».
 *
 * Y de las tres, la que más resuelve es el **camino**: distingue «se murió el
 * equipo» de «se cortó el enlace tres saltos antes». Sin eso, un equipo que no
 * contesta lleva a mandar un técnico, y la mitad de las veces el problema
 * estaba en el medio.
 *
 * ── 🔴 Sin JavaScript, y con una consecuencia que hay que aceptar ───────────
 *
 *    Es un `<form method="post">` a esta misma página. No hay redirect después
 *    del POST —a diferencia de `/inventario`— porque acá el resultado ES la
 *    respuesta: redirigir lo perdería.
 *
 *    Eso significa que recargar vuelve a sondear. Está contemplado: el
 *    servicio tiene enfriamiento por destino y contesta 429 con el tiempo que
 *    falta. Preferimos ese aviso claro antes que un script para evitarlo.
 */

interface Props {
  /** Dirección a sondear. Ya validada contra la base por el servicio. */
  destino: string | null;
  /** Qué acción se pidió en este POST, si hubo alguno. */
  accion?: string | null;
  resultado?: Resultado | null;
  /** Si no hay servicio configurado, no se ofrece nada. */
  disponible: boolean;
}

const { destino, accion = null, resultado = null, disponible } = Astro.props;

const ACCIONES = [
  { id: 'ping', texto: 'Ping ahora', ayuda: '5 sondas: ida y vuelta, pérdida y jitter en este momento.' },
  { id: 'puertos', texto: 'Probar puertos', ayuda: 'Si SSH, Winbox o la web contestan. Un equipo puede responder ping con el Winbox muerto.' },
  { id: 'traza', texto: 'Camino hasta acá', ayuda: 'Por dónde se llega y en qué salto se corta. Separa «es el equipo» de «es el enlace».' },
  { id: 'snmp', texto: 'Preguntar por SNMP', ayuda: 'Uptime, modelo, firmware y estado de cada interfaz. Sólo lectura. En esta instalación lo contesta 1 de cada 10 equipos.' },
] as const;

const p = resultado?.ok && resultado.accion === 'ping' ? (resultado.datos as Ping) : null;
const pu = resultado?.ok && resultado.accion === 'puertos' ? (resultado.datos as Puertos) : null;
const tr = resultado?.ok && resultado.accion === 'traza' ? (resultado.datos as Traza) : null;
const sn = resultado?.ok && resultado.accion === 'snmp' ? (resultado.datos as Snmp) : null;

/** «2 d 5 h», que es como lo lee un humano de guardia. */
function cuanto(s: number): string {
  const d = Math.floor(s / 86400);
  const h = Math.floor((s % 86400) / 3600);
  const m = Math.floor((s % 3600) / 60);
  return d ? `${d} d ${h} h` : h ? `${h} h ${m} min` : `${m} min`;
}

const TONO: Record<string, string> = {
  abierto: 'text-arriba-txt',
  cerrado: 'text-tenue',
  'sin respuesta': 'text-caido-txt',
  error: 'text-caido-txt',
};
---

<section class="tarjeta mb-4 p-3" aria-labelledby="t-sonda">
  <h2 id="t-sonda" class="text-tenue text-2xs mb-2 font-semibold tracking-wide uppercase">
    Preguntarle al equipo ahora
  </h2>

  {
    !disponible || !destino ? (
      <p class="text-tenue text-xs">
        {!destino
          ? 'Este elemento no tiene dirección IP, así que no hay a quién preguntarle.'
          : 'No hay servicio de sondeo configurado en este despliegue.'}
      </p>
    ) : (
      <>
        <div class="flex flex-wrap gap-2">
          {ACCIONES.map((a) => (
            <form method="post" class="contents">
              <input type="hidden" name="sondeo" value={a.id} />
              <button
                type="submit"
                title={a.ayuda}
                class:list={[
                  'border-borde bg-panel-2 hover:border-borde-fuerte hover:text-tinta rounded-lg border px-3 py-1.5 text-sm font-medium transition-colors',
                  accion === a.id ? 'border-acento text-acento-txt' : 'text-tenue',
                ]}
              >
                {a.texto}
              </button>
            </form>
          ))}
          <span class="text-tenue self-center text-2xs">contra {destino}</span>
        </div>

        {/* 🔴 El error se muestra con el MISMO peso que un resultado, y con el
            motivo cuando lo hay. Un botón que no hace nada visible es cómo se
            pierde la confianza en una herramienta: si no se pudo, hay que
            decir por qué. */}
        {resultado && !resultado.ok && (
          <div class="border-caido bg-caido-bg text-caido-txt mt-3 rounded-lg border p-2 text-xs">
            <p class="font-semibold">{resultado.error}</p>
            {resultado.motivo && <p class="mt-0.5 opacity-90">{resultado.motivo}</p>}
          </div>
        )}

        {p && (
          <div class="border-borde bg-panel-2 mt-3 rounded-lg border p-3">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
              <span class:list={['font-bold', p.respondieron ? 'text-arriba-txt' : 'text-caido-txt']}>
                {p.respondieron}/{p.sondas} respondieron
              </span>
              {p.ms_prom != null && (
                <span class="tabular-nums">
                  {p.ms_min} / <strong>{p.ms_prom}</strong> / {p.ms_max} ms
                  <span class="text-tenue text-2xs"> mín/prom/máx</span>
                </span>
              )}
              {p.jitter_ms != null && (
                <span class="tabular-nums text-tenue text-xs">jitter {p.jitter_ms} ms</span>
              )}
              {p.perdida_pct > 0 && (
                <span class="text-caido-txt tabular-nums text-xs">{p.perdida_pct} % de pérdida</span>
              )}
            </div>

            {/* Las muestras una por una, no sólo el promedio: cinco sondas de
                5 ms y una serie 2/3/40/3/2 dan promedios parecidos y son dos
                redes distintas. El promedio solo esconde exactamente eso. */}
            <div class="mt-2 flex flex-wrap gap-1">
              {p.muestras_ms.map((m) => (
                <span
                  class:list={[
                    'rounded px-1.5 py-0.5 font-mono text-2xs tabular-nums',
                    m == null ? 'bg-caido-bg text-caido-txt' : 'bg-panel text-tenue',
                  ]}
                >
                  {m == null ? 'sin resp.' : `${m} ms`}
                </span>
              ))}
            </div>

            <p class="text-tenue mt-2 text-2xs leading-snug">{p.explica}</p>
          </div>
        )}

        {pu && (
          <div class="border-borde bg-panel-2 mt-3 overflow-x-auto rounded-lg border">
            <table class="w-full text-xs">
              <tbody>
                {pu.puertos.map((x) => (
                  <tr class="border-borde/50 border-b last:border-0">
                    <td class="px-3 py-1.5 font-mono tabular-nums">{x.puerto}</td>
                    <td class="text-tenue px-3 py-1.5">{x.etiqueta}</td>
                    <td class:list={['px-3 py-1.5 font-medium', TONO[x.estado]]}>{x.estado}</td>
                    <td class="text-tenue px-3 py-1.5 tabular-nums">{x.ms != null ? `${x.ms} ms` : ''}</td>
                    <td class="text-tenue px-3 py-1.5 text-2xs">{x.detalle}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="text-tenue px-3 py-1.5 text-2xs leading-snug">
              Un equipo que contesta ping con el Winbox sin respuesta está caído para quien lo
              administra, y el monitoreo por ping lo da por sano. Eso es lo que esta tabla
              encuentra.
            </p>
          </div>
        )}

        {tr && (
          <div class="border-borde bg-panel-2 mt-3 rounded-lg border p-2">
            <ol class="space-y-0.5 text-xs">
              {tr.saltos.map((s) => (
                <li class="flex items-baseline gap-2">
                  <span class="text-tenue w-5 text-right font-mono tabular-nums">{s.ttl}</span>
                  <span class:list={['font-mono', s.direccion ? '' : 'text-tenue italic']}>
                    {s.direccion ?? 'no contestó'}
                  </span>
                  {s.ms != null && <span class="text-tenue tabular-nums">{s.ms} ms</span>}
                </li>
              ))}
            </ol>
            <p class="text-tenue mt-2 text-2xs">
              {tr.alcanzado
                ? `Se llegó al equipo en ${tr.saltos.length} saltos.`
                : tr.responde_igual
                  ? 'El camino no se completó, pero el equipo RESPONDE. No es una falla: el traceroute manda UDP a un puerto cerrado y hay equipos que nunca contestan eso —Windows no lo hace de fábrica y RouterOS le limita la tasa—. Los saltos mudos del medio son routers que no avisan del TTL agotado. Para saber si el equipo está, mirá el ping.'
                  : `No se llegó (${tr.motivo_fin}) y el equipo tampoco responde al ping. El último salto que contestó es hasta dónde llega el camino: de ahí en adelante está el problema.`}
            </p>
          </div>
        )}

        {sn && (
          <div class="border-borde bg-panel-2 mt-3 rounded-lg border p-3">
            {!sn.responde ? (
              <p class="text-tenue text-xs leading-relaxed">
                <strong class="text-tinta">No contestó SNMP.</strong> {sn.motivo}
                <br />
                <span class="text-2xs">
                  Y eso es un resultado, no una falla del panel: en esta instalación 853 de los
                  859 servicios son ping y la mayoría de los equipos no tiene SNMP habilitado.
                  Medido: contesta 1 de cada 10, incluso entre los que sí tienen contadores de
                  interfaz.
                </span>
              </p>
            ) : (
              <>
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                  {sn.uptime_s != null && (
                    <>
                      <dt class="text-tenue text-xs">Encendido hace</dt>
                      {/* 🔴 El dato que no está en ningún otro lado del panel:
                          «se reinició hace 3 horas» explica una caída que si no
                          se queda sin explicación para siempre. */}
                      <dd class="font-semibold tabular-nums">{cuanto(sn.uptime_s)}</dd>
                    </>
                  )}
                  {sn.nombre && (
                    <>
                      <dt class="text-tenue text-xs">Se llama a sí mismo</dt>
                      <dd class="font-mono text-xs">{sn.nombre}</dd>
                    </>
                  )}
                  {sn.descripcion && (
                    <>
                      <dt class="text-tenue text-xs">Modelo y firmware</dt>
                      <dd class="font-mono text-xs break-all">{sn.descripcion}</dd>
                    </>
                  )}
                  {sn.ubicacion && (
                    <>
                      <dt class="text-tenue text-xs">Ubicación</dt>
                      <dd class="text-xs">{sn.ubicacion}</dd>
                    </>
                  )}
                </dl>

                {sn.interfaces && sn.interfaces.length > 0 && (
                  <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-xs">
                      <thead class="text-tenue text-2xs text-left">
                        <tr>
                          <th class="py-1 pr-3 font-semibold">Interfaz</th>
                          <th class="py-1 pr-3 font-semibold">Está</th>
                          <th class="py-1 pr-3 font-semibold">La dejaron</th>
                          <th class="py-1 font-semibold">Velocidad</th>
                        </tr>
                      </thead>
                      <tbody>
                        {sn.interfaces.map((i) => {
                          // 🔴 «Debería andar y no anda». Es el ÚNICO estado que
                          //    pide acción, y el que un panel de ping no ve.
                          const rota = i.operativa === 'abajo' && i.administrativa === 'arriba';
                          return (
                            <tr class="border-borde/50 border-b last:border-0">
                              <td class="py-1 pr-3 font-mono">{i.nombre}</td>
                              <td
                                class:list={[
                                  'py-1 pr-3 font-medium',
                                  i.operativa === 'arriba' ? 'text-arriba-txt' : rota ? 'text-caido-txt' : 'text-tenue',
                                ]}
                              >
                                {i.operativa ?? '—'}
                                {rota && ' ← debería andar'}
                              </td>
                              <td class="text-tenue py-1 pr-3">{i.administrativa ?? '—'}</td>
                              <td class="text-tenue py-1 tabular-nums">
                                {i.velocidad_bps ? `${Math.round(i.velocidad_bps / 1e6)} Mb/s` : ''}
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                    <p class="text-tenue mt-2 text-2xs leading-snug">
                      «Está» es cómo está de verdad; «la dejaron» es cómo la configuró una persona.
                      Un puerto <strong class="text-tinta">abajo con administrativa arriba</strong> es
                      una falla: debería andar y no anda. Uno con administrativa abajo está apagado a
                      propósito y no hay nada que arreglar. Las dos se ven igual si sólo se mira el
                      estado operativo.
                    </p>
                  </div>
                )}
              </>
            )}
          </div>
        )}

        {resultado?.ok && (
          <p class="text-tenue mt-2 text-2xs">
            Medido recién, en {(resultado.datos as { ms_total: number }).ms_total} ms. No sale de
            la base: son paquetes que se mandaron ahora.
          </p>
        )}
      </>
    )
  }
</section>
