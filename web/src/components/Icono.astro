---
/**
 * El juego de iconos del panel. Uno solo, y todos con el mismo trazo.
 *
 * 🔴 Nada de emoji. No es estética: un emoji lo dibuja la fuente del sistema,
 *    así que cambia de forma y de color entre Windows, macOS y Android, no se
 *    puede teñir con el color del estado, y en un lector de pantalla se
 *    anuncia con su nombre Unicode en inglés en medio de una frase en
 *    castellano. Un `<svg>` hace las tres cosas bien.
 *
 * Trazo 1.5 y caja de 24 en todos, escalado por CSS. Mezclar grosores es lo
 * que hace que una interfaz se vea armada de retazos aunque cada pieza suelta
 * esté bien.
 *
 * Los caminos son de Lucide (ISC), redibujados acá para no traer el paquete
 * entero por seis iconos — y porque el CSP de este panel es `default-src
 * 'none'`: nada se carga de afuera, ni siquiera una fuente de iconos.
 */
interface Props {
  nombre:
    | 'ventana' | 'terminal' | 'globo' | 'carpeta' | 'copiar'
    | 'alerta' | 'reloj' | 'mover' | 'grafico' | 'flecha';
  /** Tamaño en píxeles. 16 en línea con texto, 20 en botones sueltos. */
  tam?: number;
  clase?: string;
}

const { nombre, tam = 16, clase = '' } = Astro.props;

const CAMINOS: Record<Props['nombre'], string> = {
  // Ventana de aplicación — Winbox
  ventana: 'M3 5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25v13.5A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75zM3 8.25h18',
  terminal: 'm5 8 4 4-4 4M12.5 16.5H19',
  globo: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18M3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18',
  carpeta: 'M3 7.5A1.5 1.5 0 0 1 4.5 6h4.19a1.5 1.5 0 0 1 1.06.44l1.31 1.31h7.44A1.5 1.5 0 0 1 20 9.25v8.25a1.5 1.5 0 0 1-1.5 1.5h-14A1.5 1.5 0 0 1 3 17.5z',
  copiar: 'M9 9V5.25A1.25 1.25 0 0 1 10.25 4h8.5A1.25 1.25 0 0 1 20 5.25v8.5A1.25 1.25 0 0 1 18.75 15H15M5.25 9h8.5A1.25 1.25 0 0 1 15 10.25v8.5A1.25 1.25 0 0 1 13.75 20h-8.5A1.25 1.25 0 0 1 4 18.75v-8.5A1.25 1.25 0 0 1 5.25 9',
  alerta: 'M12 9v4m0 3.5v.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0',
  reloj: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18M12 7v5l3 2',
  mover: 'M12 3v18M3 12h18M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3',
  grafico: 'M3 3v16.5A1.5 1.5 0 0 0 4.5 21H21M7 15l3.5-4 3 2.5L20 7',
  flecha: 'm9 6 6 6-6 6',
};
---

<svg
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`shrink-0 ${clase}`}
  aria-hidden="true"
  focusable="false"
><path d={CAMINOS[nombre]}></path></svg>
